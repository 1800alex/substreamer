+      while (!closed) {
+        val len = input.readInt()
+        if (len <= 0 || len > CastMessageCodec.MAX_MESSAGE) throw IOException("Bad Cast frame length $len")
+        val body = ByteArray(len).also { input.readFully(it) }
+        val msg = CastMessageCodec.decode(body) ?: continue
+        val payload = runCatching { JSONObject(msg.payload) }.getOrNull() ?: continue
