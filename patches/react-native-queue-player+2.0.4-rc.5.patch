+package com.margelo.nitro.queueplayer.cast.airplay
+
+/**
+ * An AirPlay session whose receiver volume the phone's hardware volume keys
+ * drive. AirPlay receivers never report their volume back, so the session
+ * remembers the last value it sent.
+ */
+interface AirPlayVolumeControl {
+  /** Last volume sent to the receiver: linear `0.0..1.0` over its `-30..0` dB scale. */
+  val linearVolume: Float
+
+  fun setVolume(value: Float)
+
+  companion object {
+    /**
+     * Volume a fresh connection starts at: -10 dB on the AirPlay scale.
+     * Audible on software-volume receivers such as shairport-sync, which map
+     * the AirPlay scale onto a much wider attenuation, yet below full scale for
+     * receivers that tie AirPlay volume to their master volume.
+     */
+    const val CONNECT_VOLUME = 2f / 3f
+
+    /** Linear `0.0..1.0` to AirPlay dB: `-30..0`, with `0` muted (`-144`). */
+    fun toDb(value: Float): Float {
+      val v = value.coerceIn(0f, 1f)
+      return if (v == 0f) -144f else -30f + v * 30f
+    }
+  }
+}
