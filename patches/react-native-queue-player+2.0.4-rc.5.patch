@@ -0,0 +1,32 @@
+package com.margelo.nitro.queueplayer.cast.airplay
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * The AirPlay drain threads send whole 352-frame chunks only, so a track
+ * whose length is not a multiple of a chunk leaves a tail that never drains:
+ * the sink never ends and Media3 fails the item as stuck. The tail is padded
+ * with silence up to a whole chunk at end of stream.
+ */
+class ChunkPaddingTest {
+
+  private val chunk = 352 * 4
+
+  @Test
+  fun `pads the leftover tail up to a whole chunk`() {
+    // Observed on device: 179840 bytes queued at end of stream = 127 chunks + 1024.
+    assertEquals(chunk - 1024, ChunkPadding.bytesToPad(179_840, chunk))
+  }
+
+  @Test
+  fun `needs nothing when the queue is already whole chunks`() {
+    assertEquals(0, ChunkPadding.bytesToPad(0, chunk))
+    assertEquals(0, ChunkPadding.bytesToPad(chunk * 3, chunk))
+  }
+
+  @Test
+  fun `a short tail is padded to one chunk`() {
+    assertEquals(chunk - 4, ChunkPadding.bytesToPad(4, chunk))
+  }
+}
