@@ -0,0 +1,94 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import java.io.IOException
+import java.net.DatagramPacket
+import java.net.DatagramSocket
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.SocketTimeoutException
+
+/**
+ * Browses for `_googlecast._tcp` receivers while started, in rounds: query
+ * once a second for [roundMs], publish what answered, wait [pauseMs], repeat.
+ * [onUpdate] fires (on the scanner thread) only when the list changes, and a
+ * receiver that stops answering drops out after one round.
+ *
+ * Queries go out from an ephemeral port, so responders answer by unicast
+ * (RFC 6762 §6.7 "legacy unicast"): no need to bind 5353, which Android's own
+ * mDNS daemon may hold. Plain JVM sockets; the caller holds the Wi-Fi
+ * multicast lock.
+ */
+internal class CastMdnsScanner(
+  private val target: InetSocketAddress = MDNS_GROUP,
+  private val roundMs: Long = 3_000,
+  private val pauseMs: Long = 10_000,
+  private val onUpdate: (List<DiscoveredCast>) -> Unit,
+) {
+  @Volatile private var thread: Thread? = null
+
+  @Synchronized
+  fun start() {
+    if (thread != null) return
+    thread = Thread({ run() }, "castdirect-mdns").apply { isDaemon = true; start() }
+  }
+
+  @Synchronized
+  fun stop() {
+    thread?.interrupt()
+    thread = null
+  }
+
+  /** Test hook: wait for the last scanner thread to exit. */
+  fun awaitStopped(timeoutMs: Long) {
+    lastThread?.join(timeoutMs)
+  }
+
+  @Volatile private var lastThread: Thread? = null
+
+  private fun run() {
+    val me = Thread.currentThread()
+    lastThread = me
+    var last: List<DiscoveredCast>? = null
+    val query = CastMdns.query()
+    val buf = ByteArray(9_000)
+    while (thread === me) {
+      val found = try {
+        DatagramSocket().use { socket ->
+          socket.soTimeout = 200
+          val collector = CastMdnsCollector()
+          val until = System.nanoTime() + roundMs * 1_000_000
+          var nextQuery = 0L
+          while (thread === me && System.nanoTime() < until) {
+            if (System.nanoTime() >= nextQuery) {
+              runCatching { socket.send(DatagramPacket(query, query.size, target)) }
+              nextQuery = System.nanoTime() + 1_000_000_000
+            }
+            val packet = DatagramPacket(buf, buf.size)
+            try {
+              socket.receive(packet)
+              collector.add(buf.copyOf(packet.length), packet.address)
+            } catch (_: SocketTimeoutException) {
+            }
+          }
+          collector.receivers()
+        }
+      } catch (_: IOException) {
+        null // no network right now; try again next round
+      }
+      if (thread !== me) break
+      if (found != null && found != last) {
+        last = found
+        runCatching { onUpdate(found) }
+      }
+      try {
+        Thread.sleep(pauseMs)
+      } catch (_: InterruptedException) {
+        break
+      }
+    }
+  }
+
+  companion object {
+    val MDNS_GROUP = InetSocketAddress(InetAddress.getByName("224.0.0.251"), 5353)
+  }
+}
