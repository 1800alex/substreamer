+package com.margelo.nitro.queueplayer.cast.direct
+
+import android.net.Uri
+import com.margelo.nitro.queueplayer.cast.CastMediaItem
+import com.margelo.nitro.queueplayer.cast.RemoteEndReason
+import com.margelo.nitro.queueplayer.cast.RemotePlaybackState
+import com.margelo.nitro.queueplayer.cast.RemoteRepeatMode
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.ConscryptMode
+import java.net.InetAddress
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+@ConscryptMode(ConscryptMode.Mode.OFF)
+class DirectCastSessionTest {
+
+  private val receiver = FakeCastReceiver()
+  private val leases = MediaLeaseServer(InetAddress.getByName("127.0.0.1"))
+  private val channel = CastChannel.open("127.0.0.1", receiver.port, receiver.fingerprint, timeoutMs = 3_000)
+  private val session = DirectCastSession(channel, channel.launchMediaApp(), leases, pollMs = 100)
+
+  private val tracks = listOf("a", "b", "c").map {
+    CastMediaItem(uri = Uri.parse("https://music.example/rest/stream?id=$it&t=secret"), title = "Song $it", artist = "Band")
+  }
+
+  @After
+  fun tearDown() {
+    session.close()
+    leases.close()
+    receiver.close()
+  }
+
+  private fun waitFor(what: String, condition: () -> Boolean) {
+    val deadline = System.currentTimeMillis() + 3_000
+    while (!condition()) {
+      if (System.currentTimeMillis() > deadline) throw AssertionError("timed out waiting for $what")
+      Thread.sleep(20)
+    }
+  }
+
+  @Test
+  fun `loads the start track through a lease, never the server URL`() = runBlocking {
+    session.load(tracks, startIndex = 1, startPositionMs = 30_000, playWhenReady = true)
+    waitFor("LOAD") { receiver.contentId != null }
+    val url = receiver.contentId!!
+    assertTrue(url, url.startsWith("http://127.0.0.1:") && url.contains("/lease/"))
+    assertFalse(url.contains("secret"))
+    val load = receiver.received.last { it.optString("type") == "LOAD" }
+    assertEquals(30.0, load.getDouble("currentTime"), 0.01)
+    assertEquals("Song b", load.getJSONObject("media").getJSONObject("metadata").getString("title"))
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    assertEquals(1, session.currentTrackIndex.value)
+    assertTrue(session.hasReportedState)
+  }
+
+  @Test
+  fun `transport commands reach the receiver's media session`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    session.pause()
+    waitFor("paused") { receiver.playerState == "PAUSED" }
+    session.seekTo(42_000)
+    waitFor("seek") { receiver.currentTime == 42.0 }
+    session.play()
+    waitFor("play") { receiver.playerState == "PLAYING" }
+    val sessionIds = receiver.received.filter { it.optString("type") in setOf("PAUSE", "SEEK", "PLAY") }
+      .map { it.optInt("mediaSessionId") }
+    assertEquals(listOf(1, 1, 1), sessionIds)
+  }
+
+  @Test
+  fun `seeking while paused stays paused`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    session.pause()
+    waitFor("paused") { session.state.value == RemotePlaybackState.PAUSED }
+    session.seekTo(60_000)
+    waitFor("seek") { receiver.currentTime == 60.0 }
+    val seek = receiver.received.last { it.optString("type") == "SEEK" }
+    assertEquals("PLAYBACK_PAUSE", seek.optString("resumeState"))
+  }
+
+  @Test
+  fun `advances to the next track when the receiver finishes one`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("first") { receiver.mediaSession == 1 }
+    val first = receiver.contentId
+    receiver.playerState = "IDLE"; receiver.idleReason = "FINISHED"
+    receiver.broadcastStatus()
+    waitFor("second LOAD") { receiver.mediaSession == 2 }
+    assertTrue(receiver.contentId != first)
+    waitFor("index 1") { session.currentTrackIndex.value == 1 }
+  }
+
+  @Test
+  fun `ends after the last track unless repeating`() = runBlocking {
+    val ended = CountDownLatch(1)
+    val job = kotlinx.coroutines.GlobalScope.launch { session.endedReason.collect { if (it == RemoteEndReason.FINISHED) ended.countDown() } }
+    session.load(tracks, 2, 0, true)
+    waitFor("loaded") { receiver.mediaSession == 1 }
+    receiver.playerState = "IDLE"; receiver.idleReason = "FINISHED"
+    receiver.broadcastStatus()
+    assertTrue(ended.await(3, TimeUnit.SECONDS))
+    assertEquals(RemotePlaybackState.ENDED, session.state.value)
+    job.cancel()
+
+    session.setRepeatMode(RemoteRepeatMode.ALL)
+    session.load(tracks, 2, 0, true)
+    waitFor("reloaded") { receiver.mediaSession == 2 }
+    receiver.playerState = "IDLE"; receiver.idleReason = "FINISHED"
+    receiver.broadcastStatus()
+    waitFor("wrapped") { receiver.mediaSession == 3 && session.currentTrackIndex.value == 0 }
+  }
+
+  @Test
+  fun `sets receiver volume and reports it`() {
+    session.setVolume(0.25f)
+    waitFor("receiver volume") { receiver.volume == 0.25 }
+    waitFor("session volume") { session.volume == 0.25f }
+  }
+
+  @Test
+  fun `reports the receiver going away`() {
+    val died = CountDownLatch(1)
+    session.deathListener = { died.countDown() }
+    receiver.close()
+    receiver.dropClients()
+    assertTrue(died.await(3, TimeUnit.SECONDS))
+  }
+}
