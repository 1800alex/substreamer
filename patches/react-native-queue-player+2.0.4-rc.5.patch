+package com.margelo.nitro.queueplayer.cast.direct
+
+import com.margelo.nitro.queueplayer.CastDeviceKind
+import com.margelo.nitro.queueplayer.CastProtocol
+import com.margelo.nitro.queueplayer.CastReceiver
+import com.margelo.nitro.queueplayer.CastReceiverCapabilities
+import com.margelo.nitro.queueplayer.CastStreamingModel
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class DirectCastReceiversTest {
+
+  private val garage = DiscoveredCast("192.168.1.17", 8009, "Garage Cast", "Sonicfast self-hosted receiver")
+
+  private fun sdk(name: String) = CastReceiver(
+    id = "chromecast:$name", castProtocol = CastProtocol.CHROMECAST, name = name, iconHint = CastDeviceKind.TV,
+    capabilities = CastReceiverCapabilities(true, CastStreamingModel.PULLURL, false), protocolVersion = "", modelName = "",
+  )
+
+  @Test
+  fun `maps a discovered receiver to a pull-URL Cast row`() {
+    val row = DirectCastReceivers.map(garage)
+    assertEquals("castdirect:192.168.1.17:8009:Garage%20Cast", row.id)
+    assertEquals(CastProtocol.CHROMECAST, row.castProtocol)
+    assertEquals("Garage Cast", row.name)
+    assertEquals(CastDeviceKind.SPEAKER, row.iconHint)
+    assertEquals(CastStreamingModel.PULLURL, row.capabilities.streamingModel)
+    assertEquals(false, row.capabilities.requiresPairing)
+    assertEquals("Sonicfast self-hosted receiver", row.modelName)
+  }
+
+  @Test
+  fun `maps an MPD server to an mpd row`() {
+    val row = DirectCastReceivers.map(DiscoveredCast("192.168.1.17", 6600, "Music Player @ alex-garage", "", DiscoveredCast.Kind.MPD))
+    assertEquals("mpd:192.168.1.17:6600:Music%20Player%20%40%20alex-garage", row.id)
+    assertEquals("MPD", row.modelName)
+    assertEquals(CastStreamingModel.PULLURL, row.capabilities.streamingModel)
+  }
+
+  @Test
+  fun `drops a direct row the Cast SDK already lists by name`() {
+    val real = DirectCastReceivers.map(DiscoveredCast("192.168.1.50", 8009, "Living Room TV", "Chromecast"))
+    val direct = listOf(real, DirectCastReceivers.map(garage))
+    assertEquals(listOf("Garage Cast"), DirectCastReceivers.unlisted(listOf(sdk("living room tv")), direct).map { it.name })
+    assertEquals(2, DirectCastReceivers.unlisted(emptyList(), direct).size)
+    // MPD rows never collide with a Cast SDK device of the same name.
+    val mpd = DirectCastReceivers.map(DiscoveredCast("192.168.1.50", 6600, "Living Room TV", "", DiscoveredCast.Kind.MPD))
+    assertEquals(listOf(mpd), DirectCastReceivers.unlisted(listOf(sdk("Living Room TV")), listOf(mpd)))
+  }
+}
