+package com.margelo.nitro.queueplayer.cast.airplay
+
+/**
+ * The native AirPlay drain threads send whole chunks only (352 frames), so the
+ * tail of a track that is not a whole number of chunks would sit in the ring
+ * forever: the sink never ends and Media3 fails the item as stuck. At end of
+ * stream the sinks pad that tail with silence (under one chunk, ~8 ms).
+ */
+internal object ChunkPadding {
+  /** Silence bytes that round [pendingBytes] up to a whole number of chunks. */
+  fun bytesToPad(pendingBytes: Int, chunkBytes: Int): Int =
+    (chunkBytes - pendingBytes % chunkBytes) % chunkBytes
+}
