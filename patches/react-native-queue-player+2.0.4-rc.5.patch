@@ -0,0 +1,290 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import android.util.Log
+import com.margelo.nitro.queueplayer.cast.CastMediaItem
+import com.margelo.nitro.queueplayer.cast.CastSession
+import com.margelo.nitro.queueplayer.cast.RemoteEndReason
+import com.margelo.nitro.queueplayer.cast.RemoteMediaError
+import com.margelo.nitro.queueplayer.cast.RemotePlaybackState
+import com.margelo.nitro.queueplayer.cast.RemoteRepeatMode
+import com.margelo.nitro.queueplayer.cast.chromecast.MediaInfoBuilder
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharedFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * Playback on a self-hosted Cast receiver through the Default Media Receiver.
+ * Such receivers take one item at a time (no QUEUE_* messages), so the queue
+ * lives here: each track is LOADed through a [MediaLeaseServer] lease, status
+ * is polled, and the next track is loaded when the receiver reports FINISHED.
+ */
+internal class DirectCastSession(
+  private val channel: CastChannel,
+  private val transport: String,
+  private val leases: MediaLeaseServer,
+  pollMs: Long = 1_000,
+  private val keepAwake: AutoCloseable? = null,
+) : CastSession.RemotePlayer() {
+
+  private val _state = MutableStateFlow(RemotePlaybackState.IDLE)
+  private val _positionMs = MutableStateFlow(0L)
+  private val _durationMs = MutableStateFlow(0L)
+  private val _currentTrackIndex = MutableStateFlow(-1)
+  private val _endedReason = MutableSharedFlow<RemoteEndReason>(extraBufferCapacity = 4)
+  private val _mediaError = MutableSharedFlow<RemoteMediaError>(extraBufferCapacity = 4)
+  private val _seekCompleted = MutableSharedFlow<Long>(extraBufferCapacity = 4)
+
+  override val state: StateFlow<RemotePlaybackState> = _state.asStateFlow()
+  @Volatile override var hasReportedState: Boolean = false
+  override val positionMs: StateFlow<Long> = _positionMs.asStateFlow()
+  override val durationMs: StateFlow<Long> = _durationMs.asStateFlow()
+  override val currentTrackIndex: StateFlow<Int> = _currentTrackIndex.asStateFlow()
+  override val endedReason: SharedFlow<RemoteEndReason> = _endedReason.asSharedFlow()
+  override val mediaError: SharedFlow<RemoteMediaError> = _mediaError.asSharedFlow()
+  override val seekCompleted: SharedFlow<Long> = _seekCompleted.asSharedFlow()
+
+  /** Last receiver volume `0.0..1.0` (sent or reported); NaN until known. */
+  @Volatile var volume: Float = Float.NaN
+    private set
+
+  // Queue state, confined to [worker].
+  private var queue: MutableList<CastMediaItem> = mutableListOf()
+  private var index = -1
+  private var repeat = RemoteRepeatMode.OFF
+  private var mediaSessionId: Int? = null
+  private var loadedUrl: String? = null
+  private var finishHandled = false
+
+  @Volatile private var closed = false
+  private val worker = Executors.newSingleThreadExecutor { r -> Thread(r, "cast-direct").apply { isDaemon = true } }
+  private val poller = Executors.newSingleThreadScheduledExecutor { r ->
+    Thread(r, "cast-direct-poll").apply { isDaemon = true }
+  }
+
+  init {
+    channel.onUnsolicited = { ns, payload ->
+      when {
+        ns == CastChannel.NS_MEDIA && payload.optString("type") == "MEDIA_STATUS" ->
+          onWorker { applyStatus(payload) }
+        ns == CastChannel.NS_RECEIVER && payload.optString("type") == "RECEIVER_STATUS" ->
+          payload.optJSONObject("status")?.optJSONObject("volume")?.let { volume = it.optDouble("level").toFloat() }
+        ns == CastChannel.NS_CONNECTION && payload.optString("type") == "CLOSE" -> receiverGone("closed")
+      }
+    }
+    channel.onClosed = { receiverGone("network") }
+    poller.scheduleWithFixedDelay({
+      onWorker { if (mediaSessionId != null) mediaRequest(JSONObject().put("type", "GET_STATUS")) }
+    }, pollMs, pollMs, TimeUnit.MILLISECONDS)
+  }
+
+  // ---- RemotePlayer ----
+
+  override suspend fun load(items: List<CastMediaItem>, startIndex: Int, startPositionMs: Long, playWhenReady: Boolean) {
+    onWorker {
+      queue = items.toMutableList()
+      loadIndex(startIndex.coerceIn(0, (queue.size - 1).coerceAtLeast(0)), startPositionMs, playWhenReady)
+    }
+  }
+
+  override fun play() = command("PLAY")
+  override fun pause() = command("PAUSE")
+  override fun stop() = command("STOP")
+
+  override fun seekTo(positionMs: Long) = onWorker {
+    val id = mediaSessionId ?: return@onWorker
+    // Keep the play/pause state: receivers resume after a seek without resumeState.
+    val resume = if (_state.value == RemotePlaybackState.PAUSED) "PLAYBACK_PAUSE" else "PLAYBACK_START"
+    mediaRequest(JSONObject().put("type", "SEEK").put("mediaSessionId", id)
+      .put("currentTime", positionMs / 1000.0).put("resumeState", resume))
+      ?.let { _seekCompleted.tryEmit(positionMs) }
+  }
+
+  override fun queueNext() = onWorker { if (index + 1 < queue.size) loadIndex(index + 1, 0, true) }
+  override fun queuePrev() = onWorker { if (index > 0) loadIndex(index - 1, 0, true) }
+  override fun skipToQueueIndex(index: Int) = onWorker { if (index in queue.indices) loadIndex(index, 0, true) }
+
+  override suspend fun queueInsert(items: List<CastMediaItem>, beforeIndex: Int?) = onWorker {
+    val at = beforeIndex?.coerceIn(0, queue.size) ?: queue.size
+    queue.addAll(at, items)
+    if (index >= 0 && at <= index) setIndex(index + items.size)
+  }
+
+  override suspend fun queueRemove(indices: List<Int>) = onWorker {
+    val removingCurrent = index in indices
+    var newIndex = index
+    indices.filter { it in queue.indices }.sortedDescending().forEach { i ->
+      queue.removeAt(i)
+      if (i < index) newIndex--
+    }
+    when {
+      queue.isEmpty() -> clearPlayback()
+      removingCurrent -> loadIndex(newIndex.coerceIn(0, queue.size - 1), 0, _state.value == RemotePlaybackState.PLAYING)
+      else -> setIndex(newIndex)
+    }
+  }
+
+  override suspend fun queueMove(fromIndex: Int, toIndex: Int) = onWorker {
+    if (fromIndex !in queue.indices || toIndex !in queue.indices || fromIndex == toIndex) return@onWorker
+    queue.add(toIndex, queue.removeAt(fromIndex))
+    setIndex(when {
+      index == fromIndex -> toIndex
+      fromIndex < index && toIndex >= index -> index - 1
+      fromIndex > index && toIndex <= index -> index + 1
+      else -> index
+    })
+  }
+
+  override suspend fun queueClear() = onWorker {
+    queue.clear()
+    clearPlayback()
+  }
+
+  /** Receivers following the Default Media Receiver API play at 1x only. */
+  override fun setPlaybackRate(rate: Float) = Unit
+
+  override fun setRepeatMode(mode: RemoteRepeatMode) = onWorker { repeat = mode }
+
+  override fun setVolume(value: Float) = onWorker {
+    val level = value.coerceIn(0f, 1f)
+    runCatching { channel.setVolume(level.toDouble()) }
+      .onSuccess { volume = level }
+      .onFailure { Log.w(TAG, "SET_VOLUME failed: ${it.message}") }
+  }
+
+  override fun close() {
+    if (closed) return
+    closed = true
+    poller.shutdownNow()
+    worker.execute {
+      mediaSessionId?.let { id -> runCatching { mediaRequest(JSONObject().put("type", "STOP").put("mediaSessionId", id)) } }
+      leases.revokeAll()
+      channel.close()
+      runCatching { keepAwake?.close() }
+    }
+    worker.shutdown()
+  }
+
+  // ---- internals (worker thread) ----
+
+  private fun loadIndex(i: Int, positionMs: Long, autoplay: Boolean) {
+    val item = queue.getOrNull(i) ?: return
+    leases.revokeAll()
+    val client = channel.remoteAddress
+    val source = item.uri.toString()
+    val url = leases.lease(source, item.headers.orEmpty(), item.contentType, client)
+    val art = item.artwork?.toString()?.takeIf { it.startsWith("http") || it.startsWith("file:") }
+      ?.let { leases.lease(it, item.headers.orEmpty(), null, client) }
+    val metadata = JSONObject().put("metadataType", 3)
+    item.title?.let { metadata.put("title", it) }
+    item.artist?.let { metadata.put("artist", it) }
+    item.album?.let { metadata.put("albumName", it) }
+    art?.let { metadata.put("images", JSONArray().put(JSONObject().put("url", it))) }
+    setIndex(i)
+    loadedUrl = url
+    finishHandled = false
+    mediaSessionId = null
+    _state.value = RemotePlaybackState.LOADING
+    _positionMs.value = positionMs
+    _durationMs.value = item.durationMs ?: 0L
+    val reply = mediaRequest(JSONObject().put("type", "LOAD").put("autoplay", autoplay)
+      .put("currentTime", positionMs / 1000.0)
+      .put("media", JSONObject().put("contentId", url)
+        .put("contentType", item.contentType ?: MediaInfoBuilder.guessContentType(source))
+        .put("streamType", "BUFFERED").put("metadata", metadata)))
+    if (reply == null || reply.optString("type") != "MEDIA_STATUS") {
+      _state.value = RemotePlaybackState.ERROR
+      _mediaError.tryEmit(RemoteMediaError(-1, "Receiver did not load the track"))
+    }
+  }
+
+  private fun applyStatus(payload: JSONObject) {
+    val status = payload.optJSONArray("status")?.optJSONObject(0) ?: return
+    val contentId = status.optJSONObject("media")?.optString("contentId")
+    if (!contentId.isNullOrEmpty() && contentId != loadedUrl) return // stale or another sender's media
+    status.optInt("mediaSessionId").takeIf { it > 0 }?.let { mediaSessionId = it }
+    hasReportedState = true
+    _positionMs.value = (status.optDouble("currentTime", 0.0) * 1000).toLong()
+    status.optJSONObject("media")?.optDouble("duration")?.takeIf { !it.isNaN() && it > 0 }
+      ?.let { _durationMs.value = (it * 1000).toLong() }
+    when (status.optString("playerState")) {
+      "PLAYING" -> _state.value = RemotePlaybackState.PLAYING
+      "PAUSED" -> _state.value = RemotePlaybackState.PAUSED
+      "BUFFERING" -> _state.value = RemotePlaybackState.BUFFERING
+      "IDLE" -> when (status.optString("idleReason")) {
+        "FINISHED" -> onTrackFinished()
+        "ERROR" -> {
+          _state.value = RemotePlaybackState.ERROR
+          _mediaError.tryEmit(RemoteMediaError(-1, "Receiver could not play the track"))
+        }
+        else -> _state.value = RemotePlaybackState.IDLE
+      }
+    }
+  }
+
+  private fun onTrackFinished() {
+    if (finishHandled) return
+    finishHandled = true
+    val next = when {
+      repeat == RemoteRepeatMode.SINGLE -> index
+      index + 1 < queue.size -> index + 1
+      repeat == RemoteRepeatMode.ALL && queue.isNotEmpty() -> 0
+      else -> -1
+    }
+    if (next >= 0) {
+      loadIndex(next, 0, true)
+    } else {
+      _state.value = RemotePlaybackState.ENDED
+      _endedReason.tryEmit(RemoteEndReason.FINISHED)
+    }
+  }
+
+  private fun clearPlayback() {
+    mediaSessionId?.let { id -> mediaRequest(JSONObject().put("type", "STOP").put("mediaSessionId", id)) }
+    leases.revokeAll()
+    mediaSessionId = null
+    loadedUrl = null
+    setIndex(-1)
+    _state.value = RemotePlaybackState.IDLE
+  }
+
+  private fun setIndex(i: Int) {
+    index = i
+    _currentTrackIndex.value = i
+  }
+
+  private fun command(type: String) = onWorker {
+    val id = mediaSessionId ?: return@onWorker
+    mediaRequest(JSONObject().put("type", type).put("mediaSessionId", id))
+  }
+
+  /** Media request on the app transport; applies a MEDIA_STATUS reply. Null on failure. */
+  private fun mediaRequest(payload: JSONObject): JSONObject? {
+    if (closed && payload.optString("type") != "STOP") return null
+    return runCatching { channel.request(transport, CastChannel.NS_MEDIA, payload) }
+      .onFailure { Log.w(TAG, "${payload.optString("type")} failed: ${it.message}") }
+      .getOrNull()
+      ?.also { if (it.optString("type") == "MEDIA_STATUS") applyStatus(it) }
+  }
+
+  private fun onWorker(block: () -> Unit) {
+    if (worker.isShutdown) return
+    runCatching { worker.execute { runCatching(block).onFailure { Log.w(TAG, "cast command failed", it) } } }
+  }
+
+  private fun receiverGone(reason: String) {
+    if (closed) return
+    Log.i(TAG, "Receiver connection ended ($reason)")
+    deathListener?.invoke(reason)
+  }
+
+  private companion object {
+    const val TAG = "DirectCastSession"
+  }
+}
