+/**
+ * Cast v2 connection to a self-hosted receiver, authenticated by certificate
+ * pin. The TLS layer accepts any certificate only so it can be read; the pin is
+ * checked right after the handshake and before anything is sent.
+ */
+internal class CastChannel private constructor(
+  private val socket: SSLSocket,
+  private val timeoutMs: Long,
+) : AutoCloseable {
+
+  /** Messages that are not replies to a request: status broadcasts, CLOSE. */
+  @Volatile var onUnsolicited: ((namespace: String, payload: JSONObject) -> Unit)? = null
+  /** Called once when the connection drops (not after [close]). */
+  @Volatile var onClosed: (() -> Unit)? = null
+
+  val localAddress: InetAddress get() = socket.localAddress
+  val remoteAddress: InetAddress get() = socket.inetAddress
+
+  private val output = socket.getOutputStream()
+  private val nextId = AtomicInteger(1)
+  private val waiters = ConcurrentHashMap<Int, LinkedBlockingQueue<JSONObject>>()
+  private val connected = ConcurrentHashMap.newKeySet<String>()
+  @Volatile private var closed = false
+  private val heartbeat: ScheduledExecutorService = Executors.newSingleThreadScheduledExecutor { r ->
+    Thread(r, "cast-heartbeat").apply { isDaemon = true }
+  }
+
+  init {
+    Thread({ readLoop() }, "cast-reader").apply { isDaemon = true }.start()
+    connect(PLATFORM)
+    heartbeat.scheduleWithFixedDelay({
+      runCatching { send(PLATFORM, NS_HEARTBEAT, JSONObject().put("type", "PING")) }
+    }, HEARTBEAT_S, HEARTBEAT_S, TimeUnit.SECONDS)
+  }
+
+  fun send(destination: String, namespace: String, payload: JSONObject) {
+    val bytes = CastMessageCodec.encode(CastMessage(SENDER, destination, namespace, payload.toString()))
+    synchronized(output) {
+      output.write(bytes)
+      output.flush()
+    }
+  }
+
+  /** Send with a fresh `requestId` and wait for the reply carrying it. */
+  fun request(destination: String, namespace: String, payload: JSONObject): JSONObject {
+    if (closed) throw IOException("Cast connection closed")
+    val id = nextId.getAndIncrement()
+    val queue = LinkedBlockingQueue<JSONObject>(1)
+    waiters[id] = queue
+    try {
+      send(destination, namespace, payload.put("requestId", id))
+      return queue.poll(timeoutMs, TimeUnit.MILLISECONDS)
+        ?.takeUnless { it.has(CLOSED_MARKER) }
+        ?: throw IOException("No reply to ${payload.optString("type")} (closed=$closed)")
+    } finally {
+      waiters.remove(id)
+    }
+  }
+
