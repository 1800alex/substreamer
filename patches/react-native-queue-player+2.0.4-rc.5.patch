+package com.margelo.nitro.queueplayer.cast.direct
+
+import java.io.ByteArrayOutputStream
+import java.nio.ByteBuffer
+
+/** A Cast v2 `CastMessage` with a UTF-8 string payload (all the media protocol uses). */
+internal data class CastMessage(
+  val source: String,
+  val destination: String,
+  val namespace: String,
+  val payload: String,
+)
+
+/**
+ * Cast v2 wire format: a 4-byte big-endian length, then the protobuf
+ * `CastMessage` (1 protocol_version, 2 source_id, 3 destination_id,
+ * 4 namespace, 5 payload_type, 6 payload_utf8). Hand-encoded; binary
+ * payloads (device auth) are not supported.
+ */
+internal object CastMessageCodec {
+
+  const val MAX_MESSAGE = 64 * 1024
+
+  fun encode(message: CastMessage): ByteArray {
+    val body = ByteArrayOutputStream()
+    body.write(byteArrayOf(0x08, 0x00))
+    writeString(body, 2, message.source)
+    writeString(body, 3, message.destination)
+    writeString(body, 4, message.namespace)
+    body.write(byteArrayOf(0x28, 0x00))
+    writeString(body, 6, message.payload)
+    val bytes = body.toByteArray()
+    return ByteBuffer.allocate(4 + bytes.size).putInt(bytes.size).put(bytes).array()
+  }
+
+  /** Decode a message body (without its length prefix); null when malformed. */
+  fun decode(body: ByteArray): CastMessage? {
+    var pos = 0
+    val strings = HashMap<Int, String>()
+    var payloadType = 0L
+    fun varint(): Long? {
+      var value = 0L
+      var shift = 0
+      while (shift < 64) {
+        if (pos >= body.size) return null
+        val b = body[pos++].toInt() and 0xff
+        value = value or ((b and 0x7f).toLong() shl shift)
+        if (b < 0x80) return value
+        shift += 7
+      }
+      return null
+    }
+    while (pos < body.size) {
+      val tag = varint() ?: return null
+      val field = (tag ushr 3).toInt()
+      when ((tag and 7).toInt()) {
+        0 -> {
+          val v = varint() ?: return null
+          if (field == 5) payloadType = v
+        }
+        2 -> {
+          val len = varint() ?: return null
+          if (len < 0 || pos + len > body.size) return null
+          strings[field] = String(body, pos, len.toInt(), Charsets.UTF_8)
+          pos += len.toInt()
+        }
+        else -> return null
+      }
+    }
+    if (payloadType != 0L) return null
+    return CastMessage(
+      source = strings[2] ?: return null,
+      destination = strings[3] ?: return null,
+      namespace = strings[4] ?: return null,
+      payload = strings[6] ?: return null,
+    )
+  }
+
+  private fun writeString(out: ByteArrayOutputStream, field: Int, value: String) {
+    val bytes = value.toByteArray(Charsets.UTF_8)
+    writeVarint(out, (field shl 3 or 2).toLong())
+    writeVarint(out, bytes.size.toLong())
+    out.write(bytes)
+  }
+
+  private fun writeVarint(out: ByteArrayOutputStream, value: Long) {
+    var v = value
+    while (v >= 0x80) {
+      out.write(((v and 0x7f) or 0x80).toInt())
+      v = v ushr 7
+    }
+    out.write(v.toInt())
+  }
+}
