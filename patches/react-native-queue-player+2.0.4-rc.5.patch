@@ -0,0 +1,116 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import org.junit.After
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.InetAddress
+import java.net.ServerSocket
+import kotlin.concurrent.thread
+import java.net.URL
+
+class MediaLeaseServerTest {
+
+  private val loopback = InetAddress.getByName("127.0.0.1")
+  private val audio = ByteArray(10_000) { (it % 251).toByte() }
+  private lateinit var upstream: ServerSocket
+  private val upstreamHeaders = mutableListOf<Map<String, String>>()
+  private lateinit var server: MediaLeaseServer
+
+  /** Minimal range-capable HTTP/1.1 origin standing in for the music server. */
+  private fun serveUpstream() = thread(isDaemon = true) {
+    while (!upstream.isClosed) {
+      val sock = runCatching { upstream.accept() }.getOrNull() ?: break
+      sock.use { s ->
+        val reader = s.getInputStream().bufferedReader(Charsets.ISO_8859_1)
+        reader.readLine() ?: return@use
+        val headers = generateSequence { reader.readLine()?.takeIf { it.isNotEmpty() } }
+          .associate { it.substringBefore(':').trim().lowercase() to it.substringAfter(':').trim() }
+        upstreamHeaders += headers
+        val start = headers["range"]?.removePrefix("bytes=")?.substringBefore('-')?.toInt()
+        val from = start ?: 0
+        val head = StringBuilder()
+        head.append(if (start != null) "HTTP/1.1 206 Partial Content\r\n" else "HTTP/1.1 200 OK\r\n")
+        head.append("Content-Type: audio/flac\r\nAccept-Ranges: bytes\r\n")
+        if (start != null) head.append("Content-Range: bytes $from-${audio.size - 1}/${audio.size}\r\n")
+        head.append("Content-Length: ${audio.size - from}\r\nConnection: close\r\n\r\n")
+        s.getOutputStream().write(head.toString().toByteArray())
+        s.getOutputStream().write(audio, from, audio.size - from)
+      }
+    }
+  }
+
+  @Before
+  fun setUp() {
+    upstream = ServerSocket(0, 50, loopback)
+    serveUpstream()
+    server = MediaLeaseServer(loopback)
+  }
+
+  @After
+  fun tearDown() {
+    server.close()
+    upstream.close()
+  }
+
+  private fun upstreamUrl() = "http://127.0.0.1:${upstream.localPort}/rest/stream?id=1&t=secret"
+
+  private fun fetch(url: String, range: String? = null): Triple<Int, Map<String, String>, ByteArray> {
+    val c = URL(url).openConnection() as HttpURLConnection
+    range?.let { c.setRequestProperty("Range", it) }
+    val code = c.responseCode
+    val body = (if (code < 400) c.inputStream else c.errorStream)?.use { it.readBytes() } ?: ByteArray(0)
+    val headers = c.headerFields.filterKeys { it != null }.mapValues { it.value.first() }
+    return Triple(code, headers, body)
+  }
+
+  @Test
+  fun `serves the upstream bytes through a lease without exposing its URL`() {
+    val url = server.lease(upstreamUrl(), mapOf("X-Token" to "abc"), "audio/flac", loopback)
+    assertTrue(!url.contains("secret") && !url.contains("rest/stream"))
+    val (code, headers, body) = fetch(url)
+    assertEquals(200, code)
+    assertEquals("audio/flac", headers["Content-Type"])
+    assertArrayEquals(audio, body)
+    assertEquals("abc", upstreamHeaders.last()["x-token"])
+  }
+
+  @Test
+  fun `passes Range through so the receiver can seek`() {
+    val url = server.lease(upstreamUrl(), emptyMap(), null, loopback)
+    val (code, headers, body) = fetch(url, "bytes=4000-")
+    assertEquals(206, code)
+    assertEquals("bytes 4000-9999/10000", headers["Content-Range"])
+    assertArrayEquals(audio.copyOfRange(4000, audio.size), body)
+  }
+
+  @Test
+  fun `only the receiver it was issued to may fetch a lease`() {
+    val url = server.lease(upstreamUrl(), emptyMap(), null, InetAddress.getByName("10.9.9.9"))
+    assertEquals(403, fetch(url).first)
+    assertTrue(upstreamHeaders.isEmpty())
+  }
+
+  @Test
+  fun `unknown and revoked leases are not found`() {
+    val url = server.lease(upstreamUrl(), emptyMap(), null, loopback)
+    assertEquals(404, fetch(url.substringBeforeLast('/') + "/nope").first)
+    server.revokeAll()
+    assertEquals(404, fetch(url).first)
+  }
+
+  @Test
+  fun `serves downloaded files with ranges`() {
+    val file = File.createTempFile("track", ".flac").apply { writeBytes(audio); deleteOnExit() }
+    val url = server.lease(file.toURI().toString(), emptyMap(), "audio/flac", loopback)
+    val (code, headers, body) = fetch(url, "bytes=100-199")
+    assertEquals(206, code)
+    assertEquals("bytes 100-199/10000", headers["Content-Range"])
+    assertArrayEquals(audio.copyOfRange(100, 200), body)
+    assertArrayEquals(audio, fetch(url).third)
+  }
+}
