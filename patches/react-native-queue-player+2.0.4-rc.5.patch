+package com.margelo.nitro.queueplayer.cast.direct
+
+import org.json.JSONObject
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.ConscryptMode
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+// The JDK TLS provider: Robolectric's Conscrypt needs java.net opened on JDK 17.
+@ConscryptMode(ConscryptMode.Mode.OFF)
+class CastChannelTest {
+
+  private val receiver = FakeCastReceiver()
+
+  @After
+  fun tearDown() = receiver.close()
+
+  @Test
+  fun `wrong pin closes the connection before anything is sent`() {
+    val wrong = "0".repeat(64)
+    assertThrows(CastPinMismatchException::class.java) {
+      CastChannel.open("127.0.0.1", receiver.port, wrong, timeoutMs = 3_000)
+    }
+    Thread.sleep(200)
+    assertEquals(0L, receiver.bytesReceived)
+  }
+
+  @Test
+  fun `launches the default media receiver and talks to its transport`() {
+    CastChannel.open("127.0.0.1", receiver.port, receiver.fingerprint, timeoutMs = 3_000).use { channel ->
+      val transport = channel.launchMediaApp()
+      assertEquals("garage-media", transport)
+      assertEquals(listOf("LAUNCH"), receiver.types("receiver").filter { it == "LAUNCH" })
+      assertTrue("connects to the platform and the app", receiver.types("connection").size >= 2)
+
+      val status = channel.request(transport, CastChannel.NS_MEDIA, JSONObject().put("type", "GET_STATUS"))
+      assertEquals("MEDIA_STATUS", status.getString("type"))
+    }
+  }
+
+  @Test
+  fun `colon-separated uppercase pins are accepted`() {
+    val pin = receiver.fingerprint.uppercase().chunked(2).joinToString(":")
+    CastChannel.open("127.0.0.1", receiver.port, pin, timeoutMs = 3_000).close()
+  }
+
+  @Test
+  fun `answers receiver heartbeats and reports unsolicited messages`() {
+    CastChannel.open("127.0.0.1", receiver.port, receiver.fingerprint, timeoutMs = 3_000).use { channel ->
+      val transport = channel.launchMediaApp()
+      channel.request(transport, CastChannel.NS_MEDIA, JSONObject().put("type", "LOAD")
+        .put("media", JSONObject().put("contentId", "http://x/a")))
+      val seen = java.util.concurrent.LinkedBlockingQueue<JSONObject>()
+      channel.onUnsolicited = { _, payload -> seen.add(payload) }
+      receiver.broadcastStatus()
+      val pushed = seen.poll(2, java.util.concurrent.TimeUnit.SECONDS)
+      assertEquals("MEDIA_STATUS", pushed?.getString("type"))
+    }
+  }
+}
