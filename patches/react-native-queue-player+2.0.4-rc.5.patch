+package com.margelo.nitro.queueplayer.cast.direct
+
+import com.margelo.nitro.queueplayer.CastDeviceKind
+import com.margelo.nitro.queueplayer.CastProtocol
+import com.margelo.nitro.queueplayer.CastReceiver
+import com.margelo.nitro.queueplayer.CastReceiverCapabilities
+import com.margelo.nitro.queueplayer.CastStreamingModel
+
+/**
+ * Maps [CastMdnsScanner] results onto the Nitro receiver list. MPD rows ride as
+ * CHROMECAST (pull-URL remote player, like a self-hosted Cast receiver; the
+ * Nitro enum has no MPD) and are told apart by their `mpd:` id.
+ */
+internal object DirectCastReceivers {
+
+  fun map(cast: DiscoveredCast): CastReceiver = CastReceiver(
+    id = cast.receiverId,
+    castProtocol = CastProtocol.CHROMECAST,
+    name = cast.name,
+    iconHint = CastDeviceKind.SPEAKER,
+    capabilities = CastReceiverCapabilities(
+      supportsRemoteVolume = true,
+      streamingModel = CastStreamingModel.PULLURL,
+      requiresPairing = false,
+    ),
+    protocolVersion = "",
+    modelName = if (cast.kind == DiscoveredCast.Kind.MPD) "MPD" else cast.model,
+  )
+
+  /**
+   * The [direct] rows the Cast SDK does not already list. A genuine Chromecast
+   * answers the mDNS scan too; its SDK row (Google device auth) wins.
+   */
+  fun unlisted(sdk: List<CastReceiver>, direct: List<CastReceiver>): List<CastReceiver> =
+    direct.filter { d ->
+      d.id.startsWith(DirectCastTarget.MPD_PREFIX) || sdk.none { it.name.equals(d.name, ignoreCase = true) }
+    }
+}
