+++ b/node_modules/react-native-queue-player/android/src/test/java/com/margelo/nitro/queueplayer/cast/direct/FakeMpdServer.kt
@@ -0,0 +1,103 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * A scripted Music Player Daemon on localhost: one client at a time, the
+ * commands MpdSession sends, and a status the test can steer.
+ */
+internal class FakeMpdServer(
+  private val greeting: String = "OK MPD 0.24.0",
+  /** Answer every command with ACK [4@0] (password required). */
+  @Volatile var requirePassword: Boolean = false,
+) : AutoCloseable {
+  private val server = ServerSocket(0, 4, InetAddress.getLoopbackAddress())
+  val port: Int get() = server.localPort
+
+  /** Every command line received, as sent. */
+  val received = CopyOnWriteArrayList<String>()
+
+  @Volatile var state = "stop"
+  @Volatile var songId: Int? = null
+  @Volatile var elapsed = 0.0
+  @Volatile var duration: Double? = null
+  @Volatile var volume = 70
+  @Volatile var error: String? = null
+  @Volatile var hasMixer = true
+  @Volatile var refuseSeek = false
+  @Volatile private var nextId = 1
+  /** URLs added with addid, by song id. */
+  val queue = java.util.concurrent.ConcurrentHashMap<Int, String>()
+  @Volatile private var client: Socket? = null
+
+  private val thread = Thread {
+    while (!server.isClosed) {
+      val socket = runCatching { server.accept() }.getOrNull() ?: break
+      client = socket
+      runCatching { serve(socket) }
+      runCatching { socket.close() }
+    }
+  }.apply { isDaemon = true; start() }
+
+  /** The song plays to its end: MPD stops (single-song queue). */
+  fun finish() {
+    state = "stop"
+    songId = null
+    elapsed = 0.0
+  }
+
+  /** Another client replaced the queue and plays its own song. */
+  fun takeover() {
+    songId = 999
+    state = "play"
+  }
+
+  /** Drop the control connection, as when MPD restarts. */
+  fun disconnect() {
+    runCatching { client?.close() }
+  }
+
+  private fun serve(socket: Socket) {
+    val reader = BufferedReader(InputStreamReader(socket.getInputStream(), Charsets.UTF_8))
+    val out = socket.getOutputStream()
+    fun send(text: String) { out.write(text.toByteArray(Charsets.UTF_8)); out.flush() }
+    send("$greeting\n")
+    while (true) {
+      val line = reader.readLine() ?: return
+      received += line
+      if (requirePassword) { send("ACK [4@0] {${line.substringBefore(' ')}} you don't have permission\n"); continue }
+      val args = Regex("\"((?:\\\\.|[^\"\\\\])*)\"").findAll(line).map { it.groupValues[1].replace(Regex("\\\\(.)"), "$1") }.toList()
+      when (line.substringBefore(' ')) {
+        "status" -> send(buildString {
+          append("volume: ${if (hasMixer) volume else -1}\n")
+          append("state: $state\n")
+          songId?.let { append("song: 0\nsongid: $it\n") }
+          if (songId != null) append("elapsed: $elapsed\n")
+          duration?.let { if (songId != null) append("duration: $it\n") }
+          error?.let { append("error: $it\n") }
+          append("OK\n")
+        })
+        "addid" -> { val id = nextId++; queue[id] = args[0]; send("Id: $id\nOK\n") }
+        "playid" -> { songId = args[0].toInt(); state = "play"; elapsed = 0.0; send("OK\n") }
+        "pause" -> { state = if (args[0] == "1") "pause" else "play"; send("OK\n") }
+        "seekcur" -> if (refuseSeek) send("ACK [2@0] {seekcur} Not seekable\n") else { elapsed = args[0].toDouble(); send("OK\n") }
+        "setvol" -> if (hasMixer) { volume = args[0].toInt(); send("OK\n") } else send("ACK [52@0] {setvol} No mixer\n")
+        "clear" -> { queue.clear(); songId = null; state = "stop"; send("OK\n") }
+        "stop" -> { state = "stop"; send("OK\n") }
+        "clearerror" -> { error = null; send("OK\n") }
+        "deleteid", "addtagid" -> send("OK\n")
+        else -> send("ACK [5@0] {} unknown command\n")
+      }
+    }
+  }
+
+  override fun close() {
+    runCatching { server.close() }
+    runCatching { client?.close() }
+  }
+}
