@@ -0,0 +1,189 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import java.net.InetAddress
+import java.net.URLEncoder
+
+/**
+ * A receiver found by [CastMdnsScanner]: a `_googlecast._tcp` Cast receiver or
+ * a `_mpd._tcp` Music Player Daemon. Self-hosted Cast receivers (no Google
+ * device certificate) never pass the Cast SDK's own discovery, so the app
+ * browses for them itself and connects through [CastChannel] with a
+ * certificate pin; MPD servers are driven by [MpdSession].
+ */
+internal data class DiscoveredCast(
+  val host: String,
+  val port: Int,
+  val name: String,
+  val model: String,
+  val kind: Kind = Kind.CAST,
+) {
+  enum class Kind(val service: String, val prefix: String) {
+    CAST("_googlecast._tcp.local", DirectCastTarget.PREFIX),
+    MPD("_mpd._tcp.local", DirectCastTarget.MPD_PREFIX),
+  }
+
+  /** `castdirect:` or `mpd:` + `<host>:<port>:<name>`, the id [DirectCastTarget.parse] reads. */
+  val receiverId: String
+    get() = kind.prefix + "$host:$port:" + URLEncoder.encode(name, "UTF-8").replace("+", "%20")
+}
+
+/** The one mDNS query the scanner asks, and a minimal response parser. */
+internal object CastMdns {
+  const val TYPE_A = 1
+  const val TYPE_PTR = 12
+  const val TYPE_TXT = 16
+  const val TYPE_SRV = 33
+
+  /** A one-shot query for every [DiscoveredCast.Kind] service PTR (id 0, class IN). */
+  fun query(): ByteArray {
+    val kinds = DiscoveredCast.Kind.entries
+    return byteArrayOf(0, 0, 0, 0, 0, kinds.size.toByte(), 0, 0, 0, 0, 0, 0) + kinds.fold(ByteArray(0)) { acc, kind ->
+      acc + kind.service.split('.').fold(ByteArray(0)) { name, label ->
+        val b = label.toByteArray(Charsets.US_ASCII); name + byteArrayOf(b.size.toByte()) + b
+      } + byteArrayOf(0, 0, TYPE_PTR.toByte(), 0, 1)
+    }
+  }
+
+  class Record(val name: String, val type: Int, val ttl: Long, val data: Any)
+  class Srv(val port: Int, val target: String)
+
+  /** Answer, authority and additional records; empty if the packet is malformed. */
+  fun parse(packet: ByteArray): List<Record> = runCatching { Reader(packet).records() }.getOrDefault(emptyList())
+
+  private class Reader(private val b: ByteArray) {
+    private var pos = 0
+
+    fun records(): List<Record> {
+      val questions = u16(4)
+      val count = u16(6) + u16(8) + u16(10)
+      pos = 12
+      repeat(questions) { name(); pos += 4 }
+      return List(count) {
+        val owner = name()
+        val type = u16(pos)
+        val ttl = u32(pos + 4)
+        val length = u16(pos + 8)
+        val start = pos + 10
+        require(start + length <= b.size)
+        pos = start
+        val data: Any = when (type) {
+          TYPE_A -> InetAddress.getByAddress(b.copyOfRange(start, start + 4).also { require(length == 4) }).hostAddress
+          TYPE_PTR -> name()
+          TYPE_SRV -> { pos = start + 6; Srv(u16(start + 4), name()) }
+          TYPE_TXT -> txt(start, length)
+          else -> Unit
+        }
+        pos = start + length
+        Record(owner, type, ttl, data)
+      }
+    }
+
+    private fun txt(start: Int, length: Int): Map<String, String> {
+      val out = LinkedHashMap<String, String>()
+      var i = start
+      while (i < start + length) {
+        val n = b[i].toInt() and 0xFF
+        val entry = String(b, i + 1, minOf(n, start + length - i - 1), Charsets.UTF_8)
+        val eq = entry.indexOf('=')
+        if (eq > 0) out.putIfAbsent(entry.substring(0, eq).lowercase(), entry.substring(eq + 1))
+        i += n + 1
+      }
+      return out
+    }
+
+    /** A possibly compressed name, without the trailing dot. */
+    private fun name(): String {
+      val labels = mutableListOf<String>()
+      var at = pos
+      var jumps = 0
+      var end = -1
+      while (true) {
+        val n = b[at].toInt() and 0xFF
+        when {
+          n == 0 -> { if (end < 0) end = at + 1; break }
+          n and 0xC0 == 0xC0 -> {
+            require(++jumps <= 16)
+            if (end < 0) end = at + 2
+            at = ((n and 0x3F) shl 8) or (b[at + 1].toInt() and 0xFF)
+          }
+          else -> {
+            labels += String(b, at + 1, n, Charsets.UTF_8).also { require(at + 1 + n <= b.size) }
+            at += n + 1
+          }
+        }
+      }
+      pos = end
+      return labels.joinToString(".")
+    }
+
+    private fun u16(i: Int) = ((b[i].toInt() and 0xFF) shl 8) or (b[i + 1].toInt() and 0xFF)
+    private fun u32(i: Int) = (u16(i).toLong() shl 16) or u16(i + 2).toLong()
+  }
+}
+
+/**
+ * Accumulates the records of one scan round into receivers. DNS names compare
+ * case-insensitively, so maps are keyed by the lowercased name.
+ */
+internal class CastMdnsCollector {
+  private class Instance(val label: String, val source: InetAddress, val kind: DiscoveredCast.Kind)
+
+  private val instances = LinkedHashMap<String, Instance>()
+  private val srv = HashMap<String, CastMdns.Srv>()
+  private val txt = HashMap<String, Map<String, String>>()
+  private val addresses = HashMap<String, String>()
+  private val gone = HashSet<String>() // said goodbye (PTR TTL 0)
+
+  private fun kindOfInstance(key: String) = DiscoveredCast.Kind.entries.firstOrNull { key.endsWith("." + it.service) }
+
+  fun add(packet: ByteArray, source: InetAddress) {
+    for (r in CastMdns.parse(packet)) {
+      val key = r.name.lowercase()
+      when (r.type) {
+        CastMdns.TYPE_PTR -> if (DiscoveredCast.Kind.entries.any { it.service == key }) {
+          val instance = r.data as String
+          if (r.ttl == 0L) {
+            gone += instance.lowercase()
+            instances.remove(instance.lowercase())
+          } else {
+            gone -= instance.lowercase()
+            track(instance, source, replace = false)
+          }
+        }
+        CastMdns.TYPE_SRV -> if (kindOfInstance(key) != null) {
+          srv[key] = r.data as CastMdns.Srv
+          track(r.name, source, replace = true) // the SRV sender is the device itself
+        }
+        @Suppress("UNCHECKED_CAST")
+        CastMdns.TYPE_TXT -> txt[key] = r.data as Map<String, String>
+        CastMdns.TYPE_A -> addresses[key] = r.data as String
+      }
+    }
+  }
+
+  private fun track(instance: String, source: InetAddress, replace: Boolean) {
+    val key = instance.lowercase()
+    val kind = kindOfInstance(key) ?: return
+    if (key in gone || (!replace && key in instances)) return
+    instances[key] = Instance(instance.dropLast(kind.service.length + 1), source, kind)
+  }
+
+  fun receivers(): List<DiscoveredCast> = instances.mapNotNull { (key, instance) ->
+    val service = srv[key] ?: return@mapNotNull null
+    val props = txt[key].orEmpty()
+    // avahi names an MPD server "Music Player @ host[pid]"; the pid changes on restart.
+    val label = if (instance.kind == DiscoveredCast.Kind.MPD) instance.label.replace(PID_SUFFIX, "") else instance.label
+    val name = props["fn"]?.takeIf { it.isNotBlank() } ?: label
+    DiscoveredCast(
+      host = addresses[service.target.lowercase()] ?: instance.source.hostAddress ?: return@mapNotNull null,
+      port = service.port,
+      name = name.filterNot { it.isISOControl() }.take(128),
+      model = props["md"].orEmpty(),
+      kind = instance.kind,
+    )
+  }.distinctBy { it.receiverId }
+
+  private companion object {
+    val PID_SUFFIX = Regex("""\[\d+]$""")
+  }
+}
