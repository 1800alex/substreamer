@@ -0,0 +1,67 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.DatagramPacket
+import java.net.DatagramSocket
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.TimeUnit
+
+class CastMdnsScannerTest {
+
+  /** A unicast mDNS responder on localhost that answers every query with [reply]. */
+  private class FakeResponder(@Volatile var reply: ByteArray) : AutoCloseable {
+    val socket = DatagramSocket(0, InetAddress.getLoopbackAddress())
+    val queries = LinkedBlockingQueue<ByteArray>()
+    private val thread = Thread {
+      val buf = ByteArray(1500)
+      while (!socket.isClosed) {
+        val p = DatagramPacket(buf, buf.size)
+        runCatching { socket.receive(p) }.onFailure { return@Thread }
+        queries += buf.copyOf(p.length)
+        val r = reply
+        if (r.isNotEmpty()) runCatching { socket.send(DatagramPacket(r, r.size, p.socketAddress)) }
+      }
+    }.apply { isDaemon = true; start() }
+    val address get() = InetSocketAddress(socket.localAddress, socket.localPort)
+    override fun close() = socket.close()
+  }
+
+  @Test
+  fun `publishes receivers found by each round, and their loss`() {
+    FakeResponder(MdnsPacket.pi(ip = "127.0.0.1").bytes()).use { responder ->
+      val updates = LinkedBlockingQueue<List<DiscoveredCast>>()
+      val scanner = CastMdnsScanner(target = responder.address, roundMs = 300, pauseMs = 50) { updates += it }
+      scanner.start()
+      try {
+        assertEquals(listOf(DiscoveredCast("127.0.0.1", 8009, "raspberrypi Cast", "Sonicfast self-hosted receiver")),
+          updates.poll(5, TimeUnit.SECONDS))
+        assertArrayEquals(CastMdns.query(), responder.queries.poll(1, TimeUnit.SECONDS))
+        responder.reply = ByteArray(0) // receiver went away
+        assertEquals(emptyList<DiscoveredCast>(), updates.poll(5, TimeUnit.SECONDS))
+      } finally {
+        scanner.stop()
+      }
+    }
+  }
+
+  @Test
+  fun `does not republish an unchanged list and stops promptly`() {
+    FakeResponder(MdnsPacket.pi(ip = "127.0.0.1").bytes()).use { responder ->
+      val updates = LinkedBlockingQueue<List<DiscoveredCast>>()
+      val scanner = CastMdnsScanner(target = responder.address, roundMs = 150, pauseMs = 10) { updates += it }
+      scanner.start()
+      assertEquals(1, updates.poll(5, TimeUnit.SECONDS)?.size)
+      Thread.sleep(600) // several more rounds, same answer
+      assertTrue(updates.isEmpty())
+      val stopped = System.nanoTime()
+      scanner.stop()
+      scanner.awaitStopped(2_000)
+      assertTrue((System.nanoTime() - stopped) / 1_000_000 < 1_000)
+    }
+  }
+}
