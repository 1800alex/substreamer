--- /dev/null
+++ b/node_modules/react-native-queue-player/android/src/main/java/com/margelo/nitro/queueplayer/cast/direct/MediaLeaseServer.kt
@@ -0,0 +1,197 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import android.util.Log
+import java.io.File
+import java.io.InputStream
+import java.io.OutputStream
+import java.net.HttpURLConnection
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.URI
+import java.net.URL
+import java.security.SecureRandom
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.Executors
+
+/**
+ * Local HTTP server that lets a self-hosted Cast receiver fetch the current
+ * track without learning the music server's URL or credentials. Each track
+ * gets a random, unguessable lease URL that only the receiver's address may
+ * fetch; the server proxies http(s) sources (forwarding `Range` so the
+ * receiver can seek) and serves downloaded `file:` sources directly.
+ */
+internal class MediaLeaseServer(private val bindAddress: InetAddress) : AutoCloseable {
+
+  private data class Lease(
+    val source: String,
+    val headers: Map<String, String>,
+    val contentType: String?,
+    val client: InetAddress,
+  )
+
+  private val leases = ConcurrentHashMap<String, Lease>()
+  private val random = SecureRandom()
+  private val socket = ServerSocket(0, 16, bindAddress)
+  private val workers: ExecutorService = Executors.newFixedThreadPool(MAX_CONNECTIONS) { r ->
+    Thread(r, "cast-lease").apply { isDaemon = true }
+  }
+  private val acceptor = Thread({ acceptLoop() }, "cast-lease-accept").apply {
+    isDaemon = true
+    start()
+  }
+
+  /** Issue a lease for [source] (http(s) or file URI) fetchable only by [client]. */
+  fun lease(source: String, headers: Map<String, String>, contentType: String?, client: InetAddress): String {
+    val token = ByteArray(24).also(random::nextBytes).joinToString("") { "%02x".format(it) }
+    leases[token] = Lease(source, headers, contentType, client)
+    val host = bindAddress.hostAddress.let { if (it.contains(':')) "[$it]" else it }
+    return "http://$host:${socket.localPort}/lease/$token"
+  }
+
+  fun revokeAll() = leases.clear()
+
+  override fun close() {
+    leases.clear()
+    runCatching { socket.close() }
+    workers.shutdownNow()
+  }
+
+  private fun acceptLoop() {
+    while (!socket.isClosed) {
+      val client = runCatching { socket.accept() }.getOrNull() ?: break
+      runCatching { workers.execute { client.use(::serve) } }.onFailure { client.close() }
+    }
+  }
+
+  private fun serve(client: Socket) {
+    client.soTimeout = 15_000
+    val input = client.getInputStream()
+    val out = client.getOutputStream()
+    val requestLine = readLine(input) ?: return
+    val headers = HashMap<String, String>()
+    while (true) {
+      val line = readLine(input) ?: return
+      if (line.isEmpty()) break
+      headers[line.substringBefore(':').trim().lowercase()] = line.substringAfter(':').trim()
+    }
+    val parts = requestLine.split(' ')
+    val method = parts.getOrNull(0) ?: return
+    val path = parts.getOrNull(1) ?: return
+    if (method != "GET" && method != "HEAD") return status(out, 405)
+    val lease = leases[path.removePrefix("/lease/").substringBefore('?')]
+      ?: return status(out, 404).also { diag(TAG, "$method from ${client.inetAddress.hostAddress}: unknown or revoked lease") }
+    if (client.inetAddress != lease.client) return status(out, 403)
+    val started = System.currentTimeMillis()
+    diag(TAG, "$method from ${client.inetAddress.hostAddress} range=${headers["range"]}")
+    try {
+      if (lease.source.startsWith("file:")) {
+        serveFile(out, File(URI(lease.source)), lease.contentType, headers["range"], method == "HEAD")
+      } else {
+        proxy(out, lease, headers["range"], method)
+      }
+    } catch (t: Throwable) {
+      diag(TAG, "lease request failed after ${System.currentTimeMillis() - started}ms: ${t.javaClass.simpleName}: ${t.message?.substringBefore('?')}")
+      return
+    }
+    diag(TAG, "lease request done after ${System.currentTimeMillis() - started}ms")
+  }
+
+  private fun proxy(out: OutputStream, lease: Lease, range: String?, method: String) {
+    val conn = URL(lease.source).openConnection() as HttpURLConnection
+    conn.requestMethod = method
+    conn.connectTimeout = 10_000
+    conn.readTimeout = 30_000
+    lease.headers.forEach { (k, v) -> conn.setRequestProperty(k, v) }
+    range?.let { conn.setRequestProperty("Range", it) }
+    try {
+      val code = conn.responseCode
+      diag(TAG, "upstream $code length=${conn.getHeaderField("Content-Length")} range=${conn.getHeaderField("Content-Range")}")
+      val head = StringBuilder("HTTP/1.1 $code ${reason(code)}\r\n")
+      val type = conn.getHeaderField("Content-Type") ?: lease.contentType
+      type?.let { head.append("Content-Type: $it\r\n") }
+      for (name in listOf("Content-Length", "Content-Range", "Accept-Ranges")) {
+        conn.getHeaderField(name)?.let { head.append("$name: $it\r\n") }
+      }
+      head.append("Connection: close\r\n\r\n")
+      out.write(head.toString().toByteArray(Charsets.ISO_8859_1))
+      if (method == "GET") {
+        val sent = (if (code < 400) conn.inputStream else conn.errorStream)?.use { it.copyTo(out) }
+        diag(TAG, "proxied $sent bytes")
+      }
+      out.flush()
+    } finally {
+      conn.disconnect()
+    }
+  }
+
+  private fun serveFile(out: OutputStream, file: File, type: String?, range: String?, headOnly: Boolean) {
+    if (!file.isFile) return status(out, 404)
+    val size = file.length()
+    var start = 0L
+    var end = size - 1
+    val partial = range != null
+    if (range != null) {
+      val spec = range.removePrefix("bytes=").split(',').first()
+      val a = spec.substringBefore('-')
+      val b = spec.substringAfter('-')
+      if (a.isEmpty()) {
+        start = (size - (b.toLongOrNull() ?: return status(out, 416))).coerceAtLeast(0)
+      } else {
+        start = a.toLongOrNull() ?: return status(out, 416)
+        if (b.isNotEmpty()) end = (b.toLongOrNull() ?: return status(out, 416)).coerceAtMost(size - 1)
+      }
+      if (start > end || start >= size) return status(out, 416)
+    }
+    val length = end - start + 1
+    val head = StringBuilder(if (partial) "HTTP/1.1 206 Partial Content\r\n" else "HTTP/1.1 200 OK\r\n")
+    head.append("Content-Type: ${type ?: "application/octet-stream"}\r\n")
+    head.append("Accept-Ranges: bytes\r\nContent-Length: $length\r\n")
+    if (partial) head.append("Content-Range: bytes $start-$end/$size\r\n")
+    head.append("Connection: close\r\n\r\n")
+    out.write(head.toString().toByteArray(Charsets.ISO_8859_1))
+    if (!headOnly) {
+      file.inputStream().use { input ->
+        input.skip(start)
+        val buf = ByteArray(64 * 1024)
+        var left = length
+        while (left > 0) {
+          val n = input.read(buf, 0, minOf(buf.size.toLong(), left).toInt())
+          if (n < 0) break
+          out.write(buf, 0, n)
+          left -= n
+        }
+      }
+    }
+    out.flush()
+  }
+
+  private fun status(out: OutputStream, code: Int) {
+    out.write("HTTP/1.1 $code ${reason(code)}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
+      .toByteArray(Charsets.ISO_8859_1))
+    out.flush()
+  }
+
+  private fun reason(code: Int) = when (code) {
+    200 -> "OK"; 206 -> "Partial Content"; 403 -> "Forbidden"; 404 -> "Not Found"
+    405 -> "Method Not Allowed"; 416 -> "Range Not Satisfiable"; else -> "Status"
+  }
+
+  /** One CRLF-terminated header line, bounded; null on EOF or overflow. */
+  private fun readLine(input: InputStream): String? {
+    val sb = StringBuilder()
+    while (sb.length < 8192) {
+      val c = input.read()
+      if (c < 0) return null
+      if (c == '\n'.code) return sb.toString().trimEnd('\r')
+      sb.append(c.toChar())
+    }
+    return null
+  }
+
+  private companion object {
+    const val TAG = "MediaLeaseServer"
+    const val MAX_CONNECTIONS = 4
+  }
+}
