+package com.margelo.nitro.queueplayer.cast.direct
+
+import android.content.Context
+import android.net.wifi.WifiManager
+import android.os.PowerManager
+import java.net.URLDecoder
+
+/**
+ * A manually configured self-hosted Cast receiver, addressed by receiver id
+ * `castdirect:<host>:<port>[:<url-encoded name>]`. The certificate pin travels
+ * separately as the connect password.
+ */
+internal data class DirectCastTarget(val host: String, val port: Int, val name: String) {
+  companion object {
+    const val PREFIX = "castdirect:"
+
+    fun parse(receiverId: String): DirectCastTarget? {
+      if (!receiverId.startsWith(PREFIX)) return null
+      val parts = receiverId.removePrefix(PREFIX).split(':', limit = 3)
+      val host = parts.getOrNull(0)?.takeIf { it.isNotEmpty() } ?: return null
+      val port = parts.getOrNull(1)?.toIntOrNull()?.takeIf { it in 1..65535 } ?: return null
+      val name = parts.getOrNull(2)?.let { runCatching { URLDecoder.decode(it, "UTF-8") }.getOrNull() }
+        ?.takeIf { it.isNotBlank() } ?: host
+      return DirectCastTarget(host, port, name)
+    }
+  }
+}
+
+/** Keeps the CPU and Wi-Fi up while the phone serves audio to a receiver. */
+internal class CastKeepAwake(context: Context) : AutoCloseable {
+  private val wake = (context.getSystemService(Context.POWER_SERVICE) as PowerManager)
+    .newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "QueuePlayer:DirectCast")
+    .apply { setReferenceCounted(false); acquire() }
+
+  @Suppress("DEPRECATION") // HIGH_PERF is the mode that keeps Wi-Fi awake on every API level.
+  private val wifi = (context.applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager)
+    .createWifiLock(WifiManager.WIFI_MODE_FULL_HIGH_PERF, "QueuePlayer:DirectCast")
+    .apply { setReferenceCounted(false); acquire() }
+
+  override fun close() {
+    runCatching { if (wake.isHeld) wake.release() }
+    runCatching { if (wifi.isHeld) wifi.release() }
+  }
+}
+
+/** Connect to [target] with certificate [pin] and start a media session (blocking). */
+internal fun openDirectCastSession(context: Context, target: DirectCastTarget, pin: String): DirectCastSession {
+  val channel = CastChannel.open(target.host, target.port, pin)
+  try {
+    val transport = channel.launchMediaApp()
+    val leases = MediaLeaseServer(channel.localAddress)
+    return DirectCastSession(channel, transport, leases, keepAwake = CastKeepAwake(context))
+  } catch (t: Throwable) {
+    channel.close()
+    throw t
+  }
+}
