new file mode 100644
index 0000000..67aea45
--- /dev/null
+++ b/node_modules/react-native-queue-player/android/src/main/java/com/margelo/nitro/queueplayer/cast/direct/MpdSession.kt
@@ -0,0 +1,194 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import android.util.Log
+import com.margelo.nitro.queueplayer.cast.RemoteMediaError
+import com.margelo.nitro.queueplayer.cast.RemotePlaybackState
+import java.util.Locale
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import kotlin.math.roundToInt
+
+/**
+ * Playback on a Music Player Daemon. MPD cannot take a live stream, so each
+ * track is a [MediaLeaseServer] lease that only the MPD host may fetch; MPD's
+ * curl input fetches and decodes the original. Loading replaces MPD's queue
+ * with that one song (`clear`, `addid`, `playid`); `status` is polled for
+ * position, pause and end. MPD stopping after our song started is its natural
+ * end. Another client's song is a takeover, never an end: the session reports
+ * the receiver gone.
+ */
+internal class MpdSession(
+  private val client: MpdClient,
+  private val leases: MediaLeaseServer,
+  pollMs: Long = 1_000,
+  private val keepAwake: AutoCloseable? = null,
+) : LeasedQueuePlayer("mpd") {
+
+  // Device state, confined to [worker].
+  /** MPD's id for the song we queued; null when nothing of ours is loaded. */
+  private var songId: Int? = null
+  /** Our song reached play or pause, so a later `stop` is its end. */
+  private var started = false
+  private var errorReported = false
+  /** Last status line logged, so the log shows only transitions. */
+  private var lastLogged: String? = null
+
+  private val poller = Executors.newSingleThreadScheduledExecutor { r ->
+    Thread(r, "mpd-poll").apply { isDaemon = true }
+  }
+
+  init {
+    poller.scheduleWithFixedDelay({ onWorker { if (songId != null) refresh() } }, pollMs, pollMs, TimeUnit.MILLISECONDS)
+  }
+
+  // ---- RemotePlayer ----
+
+  override fun play() = onWorker { if (songId != null && mpd { command("pause", "0") }) refresh() }
+  override fun pause() = onWorker { if (songId != null && mpd { command("pause", "1") }) refresh() }
+  override fun stop() = onWorker { if (songId != null && mpd { command("stop") }) refresh() }
+
+  override fun seekTo(positionMs: Long) = onWorker {
+    if (songId == null) return@onWorker
+    if (seek(positionMs)) _seekCompleted.tryEmit(positionMs)
+    refresh()
+  }
+
+  override fun setVolume(value: Float) = onWorker {
+    val level = value.coerceIn(0f, 1f)
+    try {
+      client.command("setvol", (level * 100).roundToInt().toString())
+      lastVolume = level
+    } catch (e: MpdException.Connection) {
+      receiverGone("network")
+    } catch (e: MpdException) {
+      Log.w(TAG, "setvol refused: ${e.message}") // an output without a mixer; playback still works
+    }
+  }
+
+  override fun close() {
+    if (closed) return
+    closed = true
+    poller.shutdownNow()
+    worker.execute {
+      songId?.let { id ->
+        runCatching { client.command("stop") }
+        runCatching { client.command("deleteid", id.toString()) }
+      }
+      leases.close()
+      client.close()
+      runCatching { keepAwake?.close() }
+    }
+    worker.shutdown()
+  }
+
+  // ---- internals (worker thread) ----
+
+  override fun loadIndex(i: Int, positionMs: Long, autoplay: Boolean) {
+    val item = queue.getOrNull(i) ?: return
+    leases.revokeAll()
+    val url = leases.lease(item.uri.toString(), item.headers.orEmpty(), item.contentType, client.remoteAddress)
+    updateIndex(i)
+    finishHandled = false
+    started = false
+    errorReported = false
+    songId = null
+    _state.value = RemotePlaybackState.LOADING
+    _positionMs.value = positionMs
+    _durationMs.value = item.durationMs ?: 0L
+    val loaded = mpd {
+      command("clearerror")
+      command("clear")
+      val id = command("addid", url).firstOrNull { it.first == "Id" }?.second?.toIntOrNull()
+        ?: throw MpdException.Refused("addid returned no id")
+      songId = id
+      // Text for MPD clients showing what plays; older servers may refuse it.
+      for ((tag, value) in listOf("Title" to item.title, "Artist" to item.artist, "Album" to item.album)) {
+        if (!value.isNullOrEmpty()) runCatching { command("addtagid", id.toString(), tag, value) }
+      }
+      command("playid", id.toString())
+    }
+    diag(TAG, "load #$i songId=$songId autoplay=$autoplay at=${positionMs}ms loaded=$loaded")
+    lastLogged = null
+    if (!loaded) {
+      if (!closed) fail("MPD did not load the track")
+      return
+    }
+    if (positionMs > 0) seek(positionMs)
+    if (!autoplay) mpd { command("pause", "1") }
+    refresh()
+  }
+
+  override fun clearPlayback() {
+    songId?.let { id -> mpd { command("stop"); command("deleteid", id.toString()) } }
+    leases.revokeAll()
+    songId = null
+    updateIndex(-1)
+    _state.value = RemotePlaybackState.IDLE
+  }
+
+  /** `seekcur`; false when MPD refuses (a source without byte ranges keeps playing). */
+  private fun seek(positionMs: Long): Boolean =
+    mpd { command("seekcur", String.format(Locale.US, "%.3f", positionMs / 1000.0)) }
+
+  private fun refresh() {
+    val ours = songId ?: return
+    val status = try {
+      client.status()
+    } catch (e: MpdException.Connection) {
+      diag(TAG, "status failed: ${e.message}")
+      receiverGone("network")
+      return
+    } catch (e: MpdException) {
+      diag(TAG, "status refused: ${e.message}")
+      fail(e.message ?: "MPD refused status")
+      return
+    }
+    val line = "state=${status.state} songId=${status.songId} ours=$ours started=$started error=${status.error}"
+    if (line != lastLogged) {
+      lastLogged = line
+      diag(TAG, "$line elapsed=${status.elapsedMs} duration=${status.durationMs}")
+    }
+    hasReportedState = true
+    status.volume?.let { lastVolume = it / 100f }
+    if (status.error != null) {
+      fail("MPD could not play the track: ${status.error}")
+      return
+    }
+    if (status.songId != null && status.songId != ours) {
+      receiverGone("takeover")
+      return
+    }
+    status.elapsedMs?.let { _positionMs.value = it }
+    status.durationMs?.takeIf { it > 0 }?.let { _durationMs.value = it }
+    when (status.state) {
+      "play" -> { started = true; _state.value = RemotePlaybackState.PLAYING }
+      "pause" -> { started = true; _state.value = RemotePlaybackState.PAUSED }
+      "stop" -> if (started) onTrackFinished()
+    }
+  }
+
+  private fun fail(message: String) {
+    _state.value = RemotePlaybackState.ERROR
+    if (!errorReported) {
+      errorReported = true
+      _mediaError.tryEmit(RemoteMediaError(-1, message))
+    }
+  }
+
+  /** Runs MPD commands; false on a refusal, and a lost connection reports the receiver gone. */
+  private inline fun mpd(block: MpdClient.() -> Unit): Boolean = try {
+    client.block()
+    true
+  } catch (e: MpdException.Connection) {
+    diag(TAG, "MPD connection lost: ${e.message}")
+    receiverGone("network")
+    false
+  } catch (e: MpdException) {
+    Log.w(TAG, "MPD refused: ${e.message}")
+    false
+  }
+
+  private companion object {
+    const val TAG = "MpdSession"
+  }
+}
