--- /dev/null
+++ b/node_modules/react-native-queue-player/android/src/main/java/com/margelo/nitro/queueplayer/cast/direct/MpdClient.kt
@@ -0,0 +1,143 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.Socket
+
+internal sealed class MpdException(message: String) : IOException(message) {
+  /** Not reachable, timed out, closed, or not speaking MPD. */
+  class Connection(message: String = "MPD connection failed") : MpdException(message)
+  /** The server wants a password; none is sent (MPD passwords travel in clear text). */
+  class Permission : MpdException("MPD requires a password")
+  /** MPD's own refusal: its ACK message text. */
+  class Refused(message: String) : MpdException(message)
+}
+
+/**
+ * One Music Player Daemon control connection
+ * (<https://mpd.readthedocs.io/en/latest/protocol.html>). Arguments are
+ * quoted and control characters replaced, so track text cannot inject
+ * commands; replies are bounded in line length and pair count.
+ */
+internal class MpdClient private constructor(private val socket: Socket) : AutoCloseable {
+
+  /** The parts of MPD's `status` reply a session follows. */
+  data class Status(
+    val state: String,
+    val songId: Int?,
+    val elapsedMs: Long?,
+    val durationMs: Long?,
+    /** 0..100, or null when the output has no mixer. */
+    val volume: Int?,
+    val error: String?,
+  )
+
+  private val input = socket.getInputStream().buffered()
+  private val output = socket.getOutputStream()
+
+  val version: String = line().let { greeting ->
+    if (!greeting.startsWith("OK MPD ")) throw MpdException.Connection("Not an MPD server")
+    greeting.removePrefix("OK MPD ")
+  }
+  val localAddress: InetAddress get() = socket.localAddress
+  val remoteAddress: InetAddress get() = socket.inetAddress
+
+  /** Sends one command with quoted [args]; returns its `key: value` reply pairs. */
+  @Synchronized
+  fun command(name: String, vararg args: String): List<Pair<String, String>> {
+    val request = StringBuilder(name)
+    for (arg in args) {
+      request.append(" \"")
+      for (c in arg) {
+        when {
+          c == '"' || c == '\\' -> request.append('\\').append(c)
+          c.isISOControl() -> request.append(' ') // a newline would end the command and start another
+          else -> request.append(c)
+        }
+      }
+      request.append('"')
+    }
+    request.append('\n')
+    try {
+      output.write(request.toString().toByteArray(Charsets.UTF_8))
+      output.flush()
+    } catch (e: IOException) {
+      throw MpdException.Connection(e.message ?: "write failed")
+    }
+    val pairs = mutableListOf<Pair<String, String>>()
+    while (true) {
+      val line = line()
+      if (line == "OK") return pairs
+      if (line.startsWith("ACK ")) {
+        // ACK [error@command_listNum] {current_command} message_text
+        val code = line.removePrefix("ACK [").substringBefore('@')
+        if (code == "4") throw MpdException.Permission()
+        throw MpdException.Refused(line.substringAfter("} ", "").take(200))
+      }
+      val colon = line.indexOf(": ")
+      if (colon <= 0) throw MpdException.Connection("Malformed MPD reply")
+      if (pairs.size < 256) pairs += line.substring(0, colon) to line.substring(colon + 2)
+    }
+  }
+
+  fun status(): Status {
+    val pairs = command("status").toMap()
+    return Status(
+      state = pairs["state"].orEmpty(),
+      songId = pairs["songid"]?.toIntOrNull(),
+      elapsedMs = pairs["elapsed"].seconds(),
+      durationMs = pairs["duration"].seconds(),
+      volume = pairs["volume"]?.toIntOrNull()?.takeIf { it in 0..100 },
+      error = pairs["error"],
+    )
+  }
+
+  override fun close() {
+    runCatching { socket.close() }
+  }
+
+  private fun String?.seconds(): Long? =
+    this?.toDoubleOrNull()?.takeIf { it.isFinite() && it in 0.0..86_400.0 }?.let { (it * 1000).toLong() }
+
+  /** One reply line without its newline; a peer streaming without newlines is refused. */
+  private fun line(): String {
+    val bytes = ByteArrayOutputStream()
+    try {
+      while (true) {
+        val b = input.read()
+        if (b < 0) throw MpdException.Connection("MPD closed the connection")
+        if (b == '\n'.code) break
+        if (bytes.size() >= MAX_LINE) throw MpdException.Connection("MPD reply line too long")
+        bytes.write(b)
+      }
+    } catch (e: MpdException) {
+      throw e
+    } catch (e: IOException) {
+      throw MpdException.Connection(e.message ?: "read failed")
+    }
+    return bytes.toString(Charsets.UTF_8.name()).trimEnd('\r')
+  }
+
+  companion object {
+    private const val MAX_LINE = 8192
+
+    /** Connect and read the greeting. Each reply must come within [timeoutMs]. */
+    fun connect(host: String, port: Int, timeoutMs: Int = 5_000): MpdClient {
+      val socket = Socket()
+      try {
+        socket.connect(InetSocketAddress(host, port), timeoutMs)
+        socket.soTimeout = timeoutMs
+        socket.tcpNoDelay = true
+        return MpdClient(socket)
+      } catch (e: MpdException) {
+        socket.close()
+        throw e
+      } catch (e: IOException) {
+        socket.close()
+        throw MpdException.Connection(e.message ?: "connect failed")
+      }
+    }
+  }
+}
