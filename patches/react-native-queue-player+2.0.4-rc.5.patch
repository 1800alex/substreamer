+    // Pioneer VSX-1123 advertises et=0,4 (none or FairPlay).
+    assertEquals(AirplayJNI.CRYPTO_CLEAR, AirPlayTxtParser.ap1Crypto("0,4"))
+  }
+
+  @Test
+  fun `receiver accepting clear and RSA gets clear audio`() {
+    // shairport-sync classic advertises et=0,1.
+    assertEquals(AirplayJNI.CRYPTO_CLEAR, AirPlayTxtParser.ap1Crypto("0,1"))
+  }
+
+  @Test
