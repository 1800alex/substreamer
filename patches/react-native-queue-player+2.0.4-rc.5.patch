index 0000000..0603dc7
--- /dev/null
+++ b/node_modules/react-native-queue-player/android/src/main/cpp/airplay2_events.c
@@ -0,0 +1,159 @@
+/**
+ * AirPlay 2 event channel — see airplay2_events.h.
+ *
+ * Records are [2-byte LE length][ChaCha20-Poly1305 ciphertext][16-byte tag],
+ * at most 1024 payload bytes, AAD = the length bytes, nonce = a per-direction
+ * 64-bit LE counter in bytes 4..11. Requests are HTTP-style; each gets an
+ * empty 200 with the request's CSeq.
+ */
+#include "airplay2_events.h"
+#include "airplay2_crypto.h"
+
+#include <errno.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define TAG "AP2Events"
+#include "airplay2_filelog.h"
+
+#define RECORD_MAX 1024
+#define PENDING_MAX (64 * 1024)
+
+static void make_nonce(uint8_t nonce[12], uint64_t counter) {
+    memset(nonce, 0, 12);
+    memcpy(nonce + 4, &counter, 8);
+}
+
+static int read_full(int fd, uint8_t *buf, size_t len) {
+    size_t got = 0;
+    while (got < len) {
+        ssize_t n = recv(fd, buf + got, len - got, 0);
+        if (n <= 0) return -1;
+        got += (size_t)n;
+    }
+    return 0;
+}
+
+static int send_record(ap2_session_t *s, const uint8_t *data, size_t len) {
+    while (len > 0) {
+        size_t chunk = len > RECORD_MAX ? RECORD_MAX : len;
+        uint8_t aad[2] = { (uint8_t)(chunk & 0xff), (uint8_t)(chunk >> 8) };
+        uint8_t nonce[12], tag[16], cipher[RECORD_MAX];
+        make_nonce(nonce, s->event_write_nonce++);
+        if (ap2_chacha20_encrypt(s->event_write_key, nonce, aad, 2,
+                                 data, chunk, cipher, tag) != 0)
+            return -1;
+        if (send(s->event_fd, aad, 2, 0) != 2 ||
+            send(s->event_fd, cipher, chunk, 0) != (ssize_t)chunk ||
+            send(s->event_fd, tag, 16, 0) != 16)
+            return -1;
+        data += chunk;
+        len -= chunk;
+    }
+    return 0;
+}
+
+/* Read one record and append its plaintext to pending. */
+static int read_record(ap2_session_t *s, uint8_t *pending, size_t *pending_len) {
+    uint8_t aad[2], tag[16], cipher[RECORD_MAX], nonce[12];
+    if (read_full(s->event_fd, aad, 2) != 0) return -1;
+    size_t len = aad[0] | ((size_t)aad[1] << 8);
+    if (len > RECORD_MAX || *pending_len + len > PENDING_MAX) return -1;
+    if (read_full(s->event_fd, cipher, len) != 0 ||
+        read_full(s->event_fd, tag, 16) != 0)
+        return -1;
+    make_nonce(nonce, s->event_read_nonce++);
+    if (ap2_chacha20_decrypt(s->event_read_key, nonce, aad, 2,
+                             cipher, len, tag, pending + *pending_len) != 0) {
+        LOGE("event record failed to decrypt");
+        return -1;
+    }
+    *pending_len += len;
+    return 0;
+}
+
+static const char *find_header(const char *head, const char *name) {
+    size_t n = strlen(name);
+    for (const char *line = head; line && *line; ) {
+        if (strncasecmp(line, name, n) == 0 && line[n] == ':') return line + n + 1;
+        line = strstr(line, "\r\n");
+        if (line) line += 2;
+    }
+    return NULL;
+}
+
+/* Acknowledge every complete request in pending; keep any partial tail. */
+static int answer_requests(ap2_session_t *s, uint8_t *pending, size_t *pending_len) {
+    for (;;) {
+        uint8_t *end = memmem(pending, *pending_len, "\r\n\r\n", 4);
+        if (!end) return *pending_len >= 8192 ? -1 : 0;
+        size_t head_len = (size_t)(end - pending) + 4;
+        char head[8192];
+        memcpy(head, pending, head_len);
+        head[head_len] = '\0';
+        const char *cl = find_header(head, "Content-Length");
+        size_t body = cl ? strtoul(cl, NULL, 10) : 0;
+        if (body > PENDING_MAX || *pending_len < head_len + body) return 0;
+        const char *cseq = find_header(head, "CSeq");
+        unsigned long seq = cseq ? strtoul(cseq, NULL, 10) : 0;
+        char reply[96];
+        int n = snprintf(reply, sizeof(reply),
+                         "HTTP/1.1 200 OK\r\nCSeq: %lu\r\nContent-Length: 0\r\n\r\n", seq);
+        LOGD("event request (CSeq %lu, %zu body bytes) acknowledged", seq, body);
+        if (send_record(s, (const uint8_t *)reply, (size_t)n) != 0) return -1;
+        memmove(pending, pending + head_len + body, *pending_len - head_len - body);
+        *pending_len -= head_len + body;
+    }
+}
+
+static void *event_thread(void *arg) {
+    ap2_session_t *s = (ap2_session_t *)arg;
+    uint8_t *pending = (uint8_t *)malloc(PENDING_MAX);
+    size_t pending_len = 0;
+    if (!pending) return NULL;
+    LOGI("Event channel serviced on fd=%d", s->event_fd);
+    while (s->event_running) {
+        struct pollfd p = { .fd = s->event_fd, .events = POLLIN };
+        int r = poll(&p, 1, 200);
+        if (r == 0) continue;
+        if (r < 0 || (p.revents & (POLLERR | POLLHUP | POLLNVAL)) ||
+            read_record(s, pending, &pending_len) != 0 ||
+            answer_requests(s, pending, &pending_len) != 0) {
+            if (s->event_running) LOGE("Event channel closed");
+            break;
+        }
+    }
+    free(pending);
+    return NULL;
+}
+
+int ap2_events_start(ap2_session_t *s) {
+    if (s->event_fd < 0 || s->event_running) return 0;
+    size_t len = s->shared_secret_len ? s->shared_secret_len : 32;
+    /* Key names are the receiver's view: we write with its read key. */
+    if (ap2_hkdf_sha512(s->shared_secret, len, "Events-Salt",
+                        "Events-Read-Encryption-Key", s->event_write_key, 32) != 0 ||
+        ap2_hkdf_sha512(s->shared_secret, len, "Events-Salt",
+                        "Events-Write-Encryption-Key", s->event_read_key, 32) != 0)
+        return -1;
+    s->event_write_nonce = 0;
+    s->event_read_nonce = 0;
+    s->event_running = 1;
+    if (pthread_create(&s->event_thread, NULL, event_thread, s) != 0) {
+        s->event_running = 0;
+        return -1;
+    }
+    return 0;
+}
+
+void ap2_events_stop(ap2_session_t *s) {
+    if (!s->event_running) return;
+    s->event_running = 0;
+    if (s->event_fd >= 0) shutdown(s->event_fd, SHUT_RDWR);
+    pthread_join(s->event_thread, NULL);
+}
