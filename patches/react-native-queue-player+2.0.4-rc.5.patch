+package com.margelo.nitro.queueplayer.cast.direct
+
+import java.security.MessageDigest
+
+/**
+ * Certificate pin for a self-hosted Cast receiver: the SHA-256 of its TLS
+ * certificate (DER), as 64 hex characters. Such receivers have no Google
+ * device certificate, so the pin is what proves the connection reached the
+ * receiver the user configured.
+ */
+internal object CastPin {
+
+  private val HEX64 = Regex("^[0-9a-f]{64}$")
+
+  /** Lowercase hex without separators, or null unless it is a full SHA-256. */
+  fun normalize(raw: String): String? =
+    raw.lowercase().filterNot { it == ':' || it.isWhitespace() }.takeIf { HEX64.matches(it) }
+
+  fun fingerprint(der: ByteArray): String =
+    MessageDigest.getInstance("SHA-256").digest(der).joinToString("") { "%02x".format(it) }
+
+  fun matches(der: ByteArray, pin: String): Boolean {
+    val expected = normalize(pin) ?: return false
+    return MessageDigest.isEqual(fingerprint(der).toByteArray(), expected.toByteArray())
+  }
+}
