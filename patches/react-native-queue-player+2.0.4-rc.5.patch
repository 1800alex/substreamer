+/**
+ * AirPlay 2 event channel: the TCP connection to the receiver's eventPort.
+ *
+ * Traffic is HAP-encrypted with keys derived from the pairing secret
+ * ("Events-Salt"). The receiver sends requests on it and expects each to be
+ * acknowledged; a Roku streams silently while they go unanswered.
+ */
+#ifndef AIRPLAY2_EVENTS_H
+#define AIRPLAY2_EVENTS_H
+
+#include "airplay2_session.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Derive the event keys and start answering requests on session->event_fd. */
+int ap2_events_start(ap2_session_t *session);
+
+/** Stop the event thread. Idempotent; call before closing event_fd. */
+void ap2_events_stop(ap2_session_t *session);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* AIRPLAY2_EVENTS_H */
