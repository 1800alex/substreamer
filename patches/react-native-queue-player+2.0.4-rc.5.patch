+package com.margelo.nitro.queueplayer.cast.direct
+
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class MpdClientTest {
+
+  private val server = FakeMpdServer()
+
+  @After
+  fun tearDown() = server.close()
+
+  @Test
+  fun `reads the greeting and key-value replies`() {
+    MpdClient.connect("127.0.0.1", server.port).use { mpd ->
+      assertEquals("0.24.0", mpd.version)
+      server.state = "pause"; server.songId = 3; server.elapsed = 12.5; server.duration = 200.0
+      val status = mpd.status()
+      assertEquals(MpdClient.Status(state = "pause", songId = 3, elapsedMs = 12_500, durationMs = 200_000, volume = 70, error = null), status)
+    }
+  }
+
+  @Test
+  fun `quotes arguments so track text cannot inject commands`() {
+    MpdClient.connect("127.0.0.1", server.port).use { mpd ->
+      mpd.command("addtagid", "1", "Title", "Say \"hi\"\nclear\\")
+    }
+    assertEquals("addtagid \"1\" \"Title\" \"Say \\\"hi\\\" clear\\\\\"", server.received.last())
+  }
+
+  @Test
+  fun `maps ACKs to permission and refusal errors`() {
+    MpdClient.connect("127.0.0.1", server.port).use { mpd ->
+      val refused = assertThrows(MpdException.Refused::class.java) { mpd.command("bogus") }
+      assertEquals("unknown command", refused.message)
+      server.requirePassword = true
+      assertThrows(MpdException.Permission::class.java) { mpd.status() }
+    }
+  }
+
+  @Test
+  fun `refuses a server that does not greet as MPD`() {
+    FakeMpdServer(greeting = "HTTP/1.1 400 Bad Request").use { other ->
+      assertThrows(MpdException.Connection::class.java) { MpdClient.connect("127.0.0.1", other.port) }
+    }
+  }
+
+  @Test
+  fun `a dropped connection is a connection error`() {
+    MpdClient.connect("127.0.0.1", server.port).use { mpd ->
+      mpd.status()
+      server.close()
+      val error = runCatching { repeat(3) { mpd.status() } }.exceptionOrNull()
+      assertTrue(error.toString(), error is MpdException.Connection)
+    }
+  }
+}
diff --git a/node_modules/react-native-queue-player/android/src/test/java/com/margelo/nitro/queueplayer/cast/direct/MpdSessionTest.kt b/node_modules/react-native-queue-player/android/src/test/java/com/margelo/nitro/queueplayer/cast/direct/MpdSessionTest.kt
new file mode 100644
index 0000000..1dfc933
--- /dev/null
+++ b/node_modules/react-native-queue-player/android/src/test/java/com/margelo/nitro/queueplayer/cast/direct/MpdSessionTest.kt
@@ -0,0 +1,173 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import android.net.Uri
+import com.margelo.nitro.queueplayer.cast.CastMediaItem
+import com.margelo.nitro.queueplayer.cast.RemoteEndReason
+import com.margelo.nitro.queueplayer.cast.RemotePlaybackState
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.net.InetAddress
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class MpdSessionTest {
+
+  private val mpd = FakeMpdServer()
+  private val leases = MediaLeaseServer(InetAddress.getByName("127.0.0.1"))
+  private val session = MpdSession(MpdClient.connect("127.0.0.1", mpd.port), leases, pollMs = 100)
+
+  private val tracks = listOf("a", "b").map {
+    CastMediaItem(uri = Uri.parse("https://music.example/rest/stream?id=$it&t=secret"), title = "Song $it", artist = "Band", album = "LP")
+  }
+
+  @After
+  fun tearDown() {
+    session.close()
+    leases.close()
+    mpd.close()
+  }
+
+  private fun waitFor(what: String, condition: () -> Boolean) {
+    val deadline = System.currentTimeMillis() + 3_000
+    while (!condition()) {
+      if (System.currentTimeMillis() > deadline) throw AssertionError("timed out waiting for $what; got ${mpd.received}")
+      Thread.sleep(20)
+    }
+  }
+
+  private fun commands() = mpd.received.filter { it != "status" }
+
+  @Test
+  fun `replaces MPD's queue with a lease of the track and labels it`() = runBlocking {
+    session.load(tracks, startIndex = 1, startPositionMs = 0, playWhenReady = true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    val url = mpd.queue.values.single()
+    assertTrue(url, url.startsWith("http://127.0.0.1:") && url.contains("/lease/"))
+    assertFalse(url.contains("secret"))
+    assertEquals(
+      listOf("clearerror", "clear", "addid \"$url\"", "addtagid \"1\" \"Title\" \"Song b\"",
+        "addtagid \"1\" \"Artist\" \"Band\"", "addtagid \"1\" \"Album\" \"LP\"", "playid \"1\""),
+      commands(),
+    )
+    assertEquals(1, session.currentTrackIndex.value)
+    assertTrue(session.hasReportedState)
+  }
+
+  @Test
+  fun `starts at the resume position and follows MPD's clock`() = runBlocking {
+    session.load(tracks, 0, startPositionMs = 30_000, playWhenReady = true)
+    waitFor("seek") { "seekcur \"30.000\"" in mpd.received }
+    mpd.elapsed = 31.5
+    waitFor("position") { session.positionMs.value == 31_500L }
+  }
+
+  @Test
+  fun `transport commands`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    session.pause()
+    waitFor("paused") { session.state.value == RemotePlaybackState.PAUSED }
+    session.seekTo(42_000)
+    waitFor("seek") { mpd.elapsed == 42.0 }
+    session.play()
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    assertEquals(listOf("pause \"1\"", "seekcur \"42.000\"", "pause \"0\""),
+      commands().filter { it.startsWith("pause") || it.startsWith("seekcur") })
+  }
+
+  @Test
+  fun `loaded paused when not playWhenReady`() = runBlocking {
+    session.load(tracks, 0, 0, playWhenReady = false)
+    waitFor("paused") { session.state.value == RemotePlaybackState.PAUSED }
+    assertTrue("pause \"1\"" in mpd.received)
+  }
+
+  @Test
+  fun `advances when MPD stops after our song, then ends`() = runBlocking {
+    val ended = CountDownLatch(1)
+    val job = launch(kotlinx.coroutines.Dispatchers.Default) { session.endedReason.collect { if (it == RemoteEndReason.FINISHED) ended.countDown() } }
+    session.load(tracks, 0, 0, true)
+    waitFor("playing a") { session.state.value == RemotePlaybackState.PLAYING }
+    mpd.finish()
+    waitFor("track b") { session.currentTrackIndex.value == 1 && mpd.songId == 2 }
+    mpd.finish()
+    assertTrue(ended.await(3, TimeUnit.SECONDS))
+    assertEquals(RemotePlaybackState.ENDED, session.state.value)
+    job.cancel()
+  }
+
+  @Test
+  fun `another client's song is a takeover, never a natural end`() = runBlocking {
+    val died = CountDownLatch(1)
+    var reason: String? = null
+    session.deathListener = { reason = it; died.countDown() }
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    mpd.takeover()
+    assertTrue(died.await(3, TimeUnit.SECONDS))
+    assertEquals("takeover", reason)
+    assertEquals(0, session.currentTrackIndex.value)
+  }
+
+  @Test
+  fun `an MPD playback error is a media error`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    mpd.error = "Failed to decode"
+    waitFor("error") { session.state.value == RemotePlaybackState.ERROR }
+  }
+
+  @Test
+  fun `a dropped connection reports the receiver gone`() = runBlocking {
+    val died = CountDownLatch(1)
+    session.deathListener = { died.countDown() }
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    mpd.close()
+    assertTrue(died.await(3, TimeUnit.SECONDS))
+  }
+
+  @Test
+  fun `volume maps to setvol and reads back, and no mixer is ignored`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("volume read") { session.volume == 0.7f }
+    session.setVolume(0.25f)
+    waitFor("setvol") { mpd.volume == 25 }
+    mpd.hasMixer = false
+    session.setVolume(0.5f)
+    waitFor("setvol refused") { "setvol \"50\"" in mpd.received }
+    assertEquals(RemotePlaybackState.PLAYING, session.state.value)
+  }
+
+  @Test
+  fun `a source MPD cannot seek keeps playing`() = runBlocking {
+    mpd.refuseSeek = true
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    session.seekTo(10_000)
+    waitFor("seek refused") { mpd.received.any { it.startsWith("seekcur") } }
+    Thread.sleep(250)
+    assertEquals(RemotePlaybackState.PLAYING, session.state.value)
+  }
+
+  @Test
+  fun `close stops our song and revokes leases`() = runBlocking {
+    session.load(tracks, 0, 0, true)
+    waitFor("playing") { session.state.value == RemotePlaybackState.PLAYING }
+    session.close()
+    waitFor("stop") { "deleteid \"1\"" in mpd.received }
+    assertTrue("stop" in mpd.received)
+    val port = java.net.URI(mpd.queue.values.single()).port
+    waitFor("lease server closed") { runCatching { java.net.Socket("127.0.0.1", port).close() }.isFailure }
+  }
+}
