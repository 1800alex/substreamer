+package com.margelo.nitro.queueplayer.cast.airplay
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/**
+ * AirPlay 1 crypto follows the receiver's `et=` TXT record. Sending RSA/AES
+ * to a receiver that does not list `1` makes it play the ciphertext as white
+ * noise, so clear is used whenever the receiver accepts it.
+ */
+class AirPlayAp1CryptoTest {
+
+  @Test
+  fun `receiver without RSA support gets clear audio`() {
+    // Pioneer VSX-1123 advertises et=0,4 (none or FairPlay).
+    assertEquals(AirplayJNI.CRYPTO_CLEAR, AirPlayTxtParser.ap1Crypto("0,4"))
+  }
+
+  @Test
+  fun `receiver accepting clear and RSA gets clear audio`() {
+    // shairport-sync classic advertises et=0,1.
+    assertEquals(AirplayJNI.CRYPTO_CLEAR, AirPlayTxtParser.ap1Crypto("0,1"))
+  }
+
+  @Test
+  fun `RSA-only receiver keeps RSA`() {
+    assertEquals(AirplayJNI.CRYPTO_RSA, AirPlayTxtParser.ap1Crypto("1"))
+  }
+
+  @Test
+  fun `missing et keeps the RSA default`() {
+    assertEquals(AirplayJNI.CRYPTO_RSA, AirPlayTxtParser.ap1Crypto(null))
+  }
+
+  @Test
+  fun `et is read from the TXT record`() {
+    assertEquals("0,4", AirPlayTxtParser.parse(mapOf("et" to "0,4")).encryptionTypes)
+  }
+}
