+      .firstOrNull { it.optString("appId") == MEDIA_APP }?.optString("transportId")
+      ?.takeIf { it.isNotEmpty() }
+      ?: throw IOException("Receiver did not report the media app")
+    connect(transport)
+    return transport
+  }
+
+  fun setVolume(level: Double) {
+    request(PLATFORM, NS_RECEIVER, JSONObject().put("type", "SET_VOLUME")
+      .put("volume", JSONObject().put("level", level.coerceIn(0.0, 1.0)).put("muted", level <= 0.0)))
+  }
+
+  private fun connect(destination: String) {
+    if (connected.add(destination)) send(destination, NS_CONNECTION, JSONObject().put("type", "CONNECT"))
+  }
+
+  private fun readLoop() {
+    val input = DataInputStream(socket.getInputStream())
+    try {
+      while (!closed) {
+        val len = input.readInt()
+        if (len <= 0 || len > CastMessageCodec.MAX_MESSAGE) throw IOException("Bad Cast frame length $len")
+        val body = ByteArray(len).also { input.readFully(it) }
+        val msg = CastMessageCodec.decode(body) ?: continue
+        val payload = runCatching { JSONObject(msg.payload) }.getOrNull() ?: continue
+        when {
+          msg.namespace == NS_HEARTBEAT && payload.optString("type") == "PING" ->
+            send(msg.source, NS_HEARTBEAT, JSONObject().put("type", "PONG"))
+          msg.namespace == NS_HEARTBEAT -> Unit
+          else -> {
+            val waiter = payload.optInt("requestId").takeIf { it > 0 }?.let { waiters[it] }
+            if (waiter != null) waiter.offer(payload) else onUnsolicited?.invoke(msg.namespace, payload)
+          }
+        }
+      }
+    } catch (t: Throwable) {
+      if (!closed) Log.i(TAG, "Cast connection ended: $t")
+    }
+    if (!closed) {
+      shutdown()
+      onClosed?.invoke()
+    }
+  }
+
+  private fun shutdown() {
+    closed = true
+    heartbeat.shutdownNow()
+    waiters.values.forEach { it.offer(JSONObject().put(CLOSED_MARKER, true)) }
+    runCatching { socket.close() }
+  }
+
+  override fun close() {
+    if (closed) return
+    runCatching {
+      connected.filter { it != PLATFORM }.forEach { send(it, NS_CONNECTION, JSONObject().put("type", "CLOSE")) }
+    }
+    shutdown()
+  }
+
+  companion object {
+    const val TAG = "CastChannel"
+    const val SENDER = "sender-0"
+    const val PLATFORM = "receiver-0"
+    const val MEDIA_APP = "CC1AD845"
+    const val NS_CONNECTION = "urn:x-cast:com.google.cast.tp.connection"
+    const val NS_HEARTBEAT = "urn:x-cast:com.google.cast.tp.heartbeat"
+    const val NS_RECEIVER = "urn:x-cast:com.google.cast.receiver"
+    const val NS_MEDIA = "urn:x-cast:com.google.cast.media"
+    private const val HEARTBEAT_S = 5L
+    private const val CLOSED_MARKER = "__closed"
+
+    /** Accepts any certificate so it can be read; [open] enforces the pin. */
+    private val readAnyCertificate = object : X509TrustManager {
+      override fun checkClientTrusted(chain: Array<out X509Certificate>?, authType: String?) = Unit
+      override fun checkServerTrusted(chain: Array<out X509Certificate>?, authType: String?) = Unit
+      override fun getAcceptedIssuers(): Array<X509Certificate> = emptyArray()
+    }
+
+    fun open(host: String, port: Int, pin: String, timeoutMs: Long = 5_000): CastChannel {
+      val ctx = SSLContext.getInstance("TLS").apply { init(null, arrayOf(readAnyCertificate), null) }
+      val socket = ctx.socketFactory.createSocket() as SSLSocket
+      try {
+        socket.connect(InetSocketAddress(host, port), timeoutMs.toInt())
+        socket.soTimeout = timeoutMs.toInt()
+        socket.startHandshake()
+        val der = socket.session.peerCertificates.firstOrNull()?.encoded
+          ?: throw CastPinMismatchException("Receiver sent no certificate")
+        if (!CastPin.matches(der, pin)) {
+          throw CastPinMismatchException(
+            "Receiver certificate SHA-256 ${CastPin.fingerprint(der)} does not match the saved fingerprint",
+          )
+        }
+        socket.soTimeout = 0
+        return CastChannel(socket, timeoutMs)
+      } catch (t: Throwable) {
+        runCatching { socket.close() }
+        throw t
+      }
+    }
+  }
+}
