@@ -0,0 +1,59 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class CastMessageCodecTest {
+
+  private fun hex(s: String) = s.chunked(2).map { it.toInt(16).toByte() }.toByteArray()
+
+  @Test
+  fun `encodes a framed CastMessage with string payload`() {
+    val framed = CastMessageCodec.encode(
+      CastMessage("sender-0", "receiver-0", "urn:x-cast:com.google.cast.tp.heartbeat", """{"type":"PING"}"""),
+    )
+    val body = framed.copyOfRange(4, framed.size)
+    assertEquals(body.size, java.nio.ByteBuffer.wrap(framed, 0, 4).int)
+    // protocol_version = 0, source, destination, namespace, payload_type = 0, payload
+    val expected = hex("0800") +
+      hex("1208") + "sender-0".toByteArray() +
+      hex("1a0a") + "receiver-0".toByteArray() +
+      hex("2227") + "urn:x-cast:com.google.cast.tp.heartbeat".toByteArray() +
+      hex("2800") +
+      hex("320f") + """{"type":"PING"}""".toByteArray()
+    assertArrayEquals(expected, body)
+  }
+
+  @Test
+  fun `decodes fields in any order, as the garage receiver writes them`() {
+    // receiver.py: 08 00, fields 2,3,4,6, then 28 00.
+    val payload = """{"type":"PONG"}"""
+    val body = hex("0800") +
+      hex("120a") + "receiver-0".toByteArray() +
+      hex("1a08") + "sender-0".toByteArray() +
+      hex("2227") + "urn:x-cast:com.google.cast.tp.heartbeat".toByteArray() +
+      hex("320f") + payload.toByteArray() +
+      hex("2800")
+    val msg = CastMessageCodec.decode(body)!!
+    assertEquals("receiver-0", msg.source)
+    assertEquals("sender-0", msg.destination)
+    assertEquals("urn:x-cast:com.google.cast.tp.heartbeat", msg.namespace)
+    assertEquals(payload, msg.payload)
+  }
+
+  @Test
+  fun `round trips long payloads with multi-byte lengths`() {
+    val payload = "x".repeat(300)
+    val framed = CastMessageCodec.encode(CastMessage("a", "b", "ns", payload))
+    assertEquals(payload, CastMessageCodec.decode(framed.copyOfRange(4, framed.size))!!.payload)
+  }
+
+  @Test
+  fun `rejects truncated or binary-payload messages`() {
+    assertNull(CastMessageCodec.decode(hex("0800120a72")))
+    // payload_type = 1 (binary) is not used by the media protocol.
+    assertNull(CastMessageCodec.decode(hex("08002801")))
+  }
+}
