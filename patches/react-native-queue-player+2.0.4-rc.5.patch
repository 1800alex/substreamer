--- /dev/null
+++ b/node_modules/react-native-queue-player/android/src/test/java/com/margelo/nitro/queueplayer/cast/direct/FakeCastReceiver.kt
@@ -0,0 +1,148 @@
+package com.margelo.nitro.queueplayer.cast.direct
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.DataInputStream
+import java.io.OutputStream
+import java.net.InetAddress
+import java.security.KeyStore
+import java.util.concurrent.CopyOnWriteArrayList
+import javax.net.ssl.KeyManagerFactory
+import javax.net.ssl.SSLContext
+import javax.net.ssl.SSLServerSocket
+import kotlin.concurrent.thread
+
+/**
+ * TLS Cast receiver for tests, modelled on the garage `receiver.py`: Default
+ * Media Receiver only, single-item LOAD, PLAY/PAUSE/SEEK/STOP/GET_STATUS,
+ * receiver SET_VOLUME. [bytesReceived] counts everything the client sent, so a
+ * test can assert nothing was sent before the certificate pin was checked.
+ */
+class FakeCastReceiver : AutoCloseable {
+
+  val fingerprint: String =
+    javaClass.getResource("/cast/receiver.sha256")!!.readText().trim()
+  val received = CopyOnWriteArrayList<JSONObject>()
+  @Volatile var bytesReceived = 0L
+  @Volatile var playerState = "IDLE"
+  @Volatile var idleReason: String? = null
+  @Volatile var currentTime = 0.0
+  @Volatile var volume = 1.0
+  @Volatile var mediaSession = 0
+  @Volatile var contentId: String? = null
+
+  private val server: SSLServerSocket
+  private val clients = CopyOnWriteArrayList<java.net.Socket>()
+  private var out: OutputStream? = null
+
+  init {
+    val ks = KeyStore.getInstance("PKCS12")
+    javaClass.getResourceAsStream("/cast/receiver.p12")!!.use { ks.load(it, "test".toCharArray()) }
+    val kmf = KeyManagerFactory.getInstance(KeyManagerFactory.getDefaultAlgorithm())
+    kmf.init(ks, "test".toCharArray())
+    val ctx = SSLContext.getInstance("TLS").apply { init(kmf.keyManagers, null, null) }
+    server = ctx.serverSocketFactory.createServerSocket(0, 4, InetAddress.getByName("127.0.0.1")) as SSLServerSocket
+    thread(isDaemon = true) { acceptLoop() }
+  }
+
+  val port: Int get() = server.localPort
+
+  fun types(namespaceSuffix: String): List<String> =
+    received.filter { it.optString("_ns").endsWith(namespaceSuffix) }.map { it.optString("type") }
+
+  /** Push an unsolicited MEDIA_STATUS, as a receiver does when a track ends. */
+  fun broadcastStatus() = synchronized(this) { out?.let { send(it, "garage-media", MEDIA, mediaStatus(0)) } }
+
+  private fun acceptLoop() {
+    while (!server.isClosed) {
+      val sock = runCatching { server.accept() }.getOrNull() ?: break
+      clients += sock
+      thread(isDaemon = true) {
+        runCatching {
+          sock.use { s ->
+            val input = DataInputStream(s.getInputStream())
+            synchronized(this) { out = s.getOutputStream() }
+            while (true) {
+              val len = input.readInt()
+              val body = ByteArray(len).also { input.readFully(it) }
+              bytesReceived += 4 + len
+              val msg = CastMessageCodec.decode(body) ?: break
+              val json = JSONObject(msg.payload).put("_ns", msg.namespace).put("_dst", msg.destination)
+              received += json
+              val reply = handle(msg.namespace, json) ?: continue
+              synchronized(this) { send(s.getOutputStream(), msg.destination, msg.namespace, reply) }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  private fun handle(ns: String, p: JSONObject): JSONObject? {
+    val id = p.optInt("requestId")
+    return when (ns) {
+      HEARTBEAT -> if (p.optString("type") == "PING") JSONObject().put("type", "PONG") else null
+      RECEIVER -> when {
+        p.optString("type") == "LAUNCH" && p.optString("appId") != "CC1AD845" ->
+          JSONObject().put("type", "LAUNCH_ERROR").put("requestId", id).put("reason", "APP_NOT_FOUND")
+        else -> {
+          if (p.optString("type") == "SET_VOLUME") volume = p.getJSONObject("volume").optDouble("level", volume)
+          JSONObject().put("type", "RECEIVER_STATUS").put("requestId", id).put("status", JSONObject()
+            .put("applications", JSONArray().put(JSONObject().put("appId", "CC1AD845")
+              .put("sessionId", "garage").put("transportId", "garage-media")))
+            .put("volume", JSONObject().put("level", volume).put("muted", false)))
+        }
+      }
+      MEDIA -> {
+        when (p.optString("type")) {
+          "LOAD" -> {
+            mediaSession++
+            contentId = p.getJSONObject("media").optString("contentId")
+            currentTime = p.optDouble("currentTime", 0.0)
+            playerState = if (p.optBoolean("autoplay", true)) "PLAYING" else "PAUSED"
+            idleReason = null
+          }
+          "PLAY" -> playerState = "PLAYING"
+          "PAUSE" -> playerState = "PAUSED"
+          "SEEK" -> {
+            // receiver.py: playback resumes unless resumeState is PLAYBACK_PAUSE.
+            currentTime = p.optDouble("currentTime")
+            playerState = if (p.optString("resumeState") == "PLAYBACK_PAUSE") "PAUSED" else "PLAYING"
+          }
+          "STOP" -> { playerState = "IDLE"; idleReason = "CANCELLED" }
+        }
+        mediaStatus(id)
+      }
+      else -> null
+    }
+  }
+
+  private fun mediaStatus(requestId: Int): JSONObject {
+    val status = JSONArray()
+    if (mediaSession > 0) {
+      val s = JSONObject().put("mediaSessionId", mediaSession).put("playerState", playerState)
+        .put("currentTime", currentTime).put("media", JSONObject().put("contentId", contentId).put("duration", 180.0))
+      idleReason?.let { s.put("idleReason", it) }
+      status.put(s)
+    }
+    return JSONObject().put("type", "MEDIA_STATUS").put("requestId", requestId).put("status", status)
+  }
+
+  private fun send(out: OutputStream, destination: String, ns: String, payload: JSONObject) {
+    out.write(CastMessageCodec.encode(CastMessage(destination, "sender-0", ns, payload.toString())))
+    out.flush()
+  }
+
+  /** Drop every client connection, as when the receiver restarts. */
+  fun dropClients() = clients.forEach { runCatching { it.close() } }
+
+  override fun close() {
+    runCatching { server.close() }
+  }
+
+  companion object {
+    const val HEARTBEAT = "urn:x-cast:com.google.cast.tp.heartbeat"
+    const val RECEIVER = "urn:x-cast:com.google.cast.receiver"
+    const val MEDIA = "urn:x-cast:com.google.cast.media"
+  }
+}
